server/node_modules/
server/*.log

# ── Secrets : ne doivent jamais entrer dans l'historique ──
# Un secret poussé une fois est compromis, même supprimé au commit suivant.
.env
.env.*
!.env.example
config.json
server/config.json
*.pem
*.key
*.p12

# ── Divers ──
.DS_Store
node_modules/

# Outillage local : etat de session, jamais versionne
.claude/proven-config.json
.claude/.proven-config-version
.claude-flow/
.swarm/

# ── Fichiers de comparaison du concepteur : jamais versionnés ──
# Il produit des copies « avant » pour juger un redessin côte à côte (2 Mo pièce).
# Sans ces motifs, un « git add . » les ferait entrer dans un dépôt de production.
*-avant.html
*-apres.html

# ⛔ LA BASE RÉELLE D'UN CLIENT NE RENTRE JAMAIS DANS L'HISTORIQUE.
# `tests/test-732.js` éprouve le convertisseur du socle sur une base exportée par
# `exportData()` depuis un appareil — des noms, des adresses et des coordonnées de vrais
# clients. Ce dépôt est PUBLIC. Un fichier poussé une fois est publié, même supprimé au
# commit suivant : c'est exactement la règle des secrets, quelques lignes plus haut.
scratchpad/base-reelle.json
scratchpad/base-*.json
