<title>Documents sur mesure</title>
<meta name="claude:viewport-fit-sides" content="cover">
<!-- polices : la feuille Google est REMISE (décision du chef de chantier, 17 novembre 2026). L'audit de sécurité l'avait retirée (S18 : l'adresse IP
     de chaque personne part chez un tiers) ; mais sans elle les treize polices proposées retombent sur deux polices de l'appareil : un choix qui ne
     change plus rien, sur un écran que Justin a validé. Dans le PROTOTYPE (entreprise fictive) le choix doit agir, et l'artefact n'admet que cet hôte
     de polices. Dans la VRAIE application, la règle de S18 tient : les polices se servent depuis notre serveur, jamais depuis Google. Si la feuille ne
     charge pas (hors ligne, hôte refusé), chaque famille retombe sur SANS_PILE / SERIF_PILE. -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Nunito+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Lora:wght@400..700&family=Playfair+Display:wght@400..800&family=Merriweather:wght@400;500;700&family=Libre+Baskerville:wght@400;500;700&family=Montserrat:wght@400..800&family=Poppins:wght@400;500;600;700&family=Work+Sans:wght@400..700&family=DM+Sans:wght@400..700&family=IBM+Plex+Sans:wght@400;500;600;700&family=Raleway:wght@400..700&display=swap">
<style>
/* ═══════════════════════════════════════════════════════════════════════════
   DOCUMENTS SUR MESURE — prototype OP GESTION (devis + contrats)
   Feuille de style, dans l'ordre : 1 jetons · 2 base · 3 accueil · 4 éditeur (barre, bureau, panneau)
   5 papier (la feuille A4) · 6 modèles de mise en page · 7 outils flottants (menus, bulles, glisser)
   ANCRE PASSE 2 : le panneau Format, l'aperçu plein écran, l'envoi, les modèles — écrire à la suite, section 8.
   PASSE 3 (faite) : contrats, étiquettes de variables, clauses, IA — section 9 du feuille de style, 2b / 5b / 9b / 9c du script.
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── 1. JETONS (jour) — même famille que le prototype d'OP GESTION ── */
:root{
  color-scheme:light;
  --police:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI Variable Text","Segoe UI",Roboto,"Noto Sans",system-ui,sans-serif;
  --r:12px; --r-s:8px; --r-l:18px;
  --ressort:cubic-bezier(.32,.72,0,1);
  --fond:#f3f5f9; --surf:#ffffff; --surf2:#f6f7fb; --bureau:#e3e6ed; --barre:rgba(255,255,255,.84);
  --encre:#0b1426; --doux:#46526a; --faible:#5a6379;
  --trait:rgba(11,20,38,.10); --trait2:rgba(11,20,38,.18); --survol:rgba(11,20,38,.055);
  --accent:#0a5fc2; --accent-fond:rgba(10,95,194,.10); --on-accent:#ffffff;
  --vert:#196e34; --orange:#994900; --rouge:#b0263c; --ambre:#8a5300; --ambre-txt:#6b3f00; --on-rouge:#ffffff;
  --ombre-seg:0 1px 3px rgba(11,20,38,.14); --marque-1:#1f5fbf; --marque-2:#12306b; --on-marque:#ffffff; --bouton-blanc:#ffffff; --ombre-bouton:0 1px 2px rgba(0,0,0,.3);
  --ombre:0 1px 2px rgba(11,20,38,.05),0 10px 30px rgba(11,20,38,.08);
  --ombre-haute:0 18px 50px rgba(11,20,38,.22);
  --ombre-feuille:0 1px 3px rgba(11,20,38,.10),0 12px 40px rgba(11,20,38,.14);
  --voile:rgba(11,20,38,.34);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --fond:#0c1424; --surf:#17233b; --surf2:#1e2a42; --bureau:#080e1b; --barre:rgba(21,33,58,.84);
    --encre:#f0f3f8; --doux:#b8c1d1; --faible:#93a0b7;
    --trait:rgba(255,255,255,.10); --trait2:rgba(255,255,255,.18); --survol:rgba(255,255,255,.07);
    --accent:#6aabff; --accent-fond:rgba(106,171,255,.16); --on-accent:#0b1426;
    --vert:#30d158; --orange:#ff9f0a; --rouge:#ff7d8e; --ambre:#ffd60a; --ambre-txt:#ffd60a; --on-rouge:#2a0a10; --ombre-seg:0 1px 3px rgba(0,0,0,.4);
    --ombre:0 1px 2px rgba(0,0,0,.25),0 12px 32px rgba(0,0,0,.28);
    --ombre-haute:0 18px 50px rgba(0,0,0,.55);
    --ombre-feuille:0 1px 3px rgba(0,0,0,.4),0 14px 44px rgba(0,0,0,.5);
    --voile:rgba(2,5,12,.62);
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --fond:#0c1424; --surf:#17233b; --surf2:#1e2a42; --bureau:#080e1b; --barre:rgba(21,33,58,.84);
  --encre:#f0f3f8; --doux:#b8c1d1; --faible:#93a0b7;
  --trait:rgba(255,255,255,.10); --trait2:rgba(255,255,255,.18); --survol:rgba(255,255,255,.07);
  --accent:#6aabff; --accent-fond:rgba(106,171,255,.16); --on-accent:#0b1426;
  --vert:#30d158; --orange:#ff9f0a; --rouge:#ff7d8e; --ambre:#ffd60a; --ambre-txt:#ffd60a; --on-rouge:#2a0a10; --ombre-seg:0 1px 3px rgba(0,0,0,.4);
  --ombre:0 1px 2px rgba(0,0,0,.25),0 12px 32px rgba(0,0,0,.28);
  --ombre-haute:0 18px 50px rgba(0,0,0,.55);
  --ombre-feuille:0 1px 3px rgba(0,0,0,.4),0 14px 44px rgba(0,0,0,.5);
  --voile:rgba(2,5,12,.62);
}

/* ── 2. BASE ── */
*{box-sizing:border-box}
html,body{height:100%;margin:0}
html{background:var(--fond)}
body{background:var(--fond);color:var(--encre);font-family:var(--police);font-size:16px;line-height:1.45;-webkit-font-smoothing:antialiased;-webkit-text-size-adjust:100%;overflow:hidden;overflow:clip}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:6px}
[hidden]{display:none!important}
#app{height:100%;position:relative;overflow:hidden;overflow:clip}
.ic{width:18px;height:18px;flex:none;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
@keyframes apparait{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
@keyframes monte{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

/* boutons de l'interface */
.bt{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:34px;padding:0 11px;border:0;border-radius:var(--r-s);background:transparent;color:var(--encre);font-size:14px;font-weight:550;white-space:nowrap;transition:background .15s}
.bt:hover{background:var(--survol)}
.bt[aria-pressed="true"],.bt[aria-expanded="true"]{background:var(--accent-fond);color:var(--accent)}
.bt:disabled{opacity:.4;cursor:default;background:transparent}
.bt.primaire{background:var(--accent);color:var(--on-accent);padding:0 15px}
.bt.primaire:hover{filter:brightness(1.06)}
.bt.contour{border:1px solid var(--trait2);background:var(--surf)}
.bt.danger{color:var(--rouge)}
.bt.primaire.rouge{background:var(--rouge);color:var(--on-rouge)}
.bt.icone{width:34px;padding:0}
@media (pointer:coarse){.bt{min-height:44px}.bt.icone{width:44px}}
.pill{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 10px;border-radius:999px;font-size:12.5px;font-weight:600;background:var(--survol);color:var(--doux);white-space:nowrap}
.pill.p-envoye,.pill.p-attente{background:color-mix(in srgb,var(--ambre) 15%,transparent);color:var(--ambre)}
.pill.p-signe{background:color-mix(in srgb,var(--vert) 15%,transparent);color:var(--vert)}
.pill.p-brouillon{background:var(--survol);color:var(--doux)}

/* ── 3. ACCUEIL ── */
.accueil{height:100%;overflow:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));-webkit-overflow-scrolling:touch}
.acc-in{max-width:900px;margin:0 auto;padding:max(18px,env(safe-area-inset-top,0px)) 0 72px}
.acc-haut{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px;margin-bottom:34px}
.acc-marque{display:flex;align-items:center;gap:10px;font-weight:650;font-size:14px;color:var(--doux);letter-spacing:.02em}
.acc-marque i{width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,var(--marque-1),var(--marque-2));display:grid;place-items:center;font-style:normal;font-weight:800;font-size:11px;color:var(--on-marque)}
.mode-seg{display:flex;padding:3px;border-radius:11px;background:var(--survol);border:1px solid var(--trait)}
.mode-seg button{min-height:32px;padding:0 12px;border:0;border-radius:8px;background:none;color:var(--doux);font-size:13px;font-weight:600}
.mode-seg button[aria-pressed="true"]{background:var(--surf);color:var(--encre);box-shadow:var(--ombre-seg)}
@media (pointer:coarse){.mode-seg button{min-height:44px}}
.accueil h1{margin:0 0 8px;font-size:clamp(30px,5vw,42px);line-height:1.12;letter-spacing:-.02em;text-wrap:balance}
.chapo{margin:0 0 30px;color:var(--doux);font-size:17px;max-width:56ch;text-wrap:pretty}
.entrees{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:16px;margin-bottom:44px}
.entree{display:flex;flex-direction:column;align-items:flex-start;gap:6px;min-height:176px;padding:22px;border:1px solid var(--trait);border-radius:var(--r-l);background:var(--surf);box-shadow:var(--ombre);text-align:left;transition:transform .2s var(--ressort),border-color .15s}
.entree:hover{border-color:var(--trait2);transform:translateY(-1px)}
.entree .gros{width:46px;height:46px;border-radius:13px;display:grid;place-items:center;background:var(--accent-fond);color:var(--accent);margin-bottom:10px}
.entree .gros .ic{width:24px;height:24px}
.entree b{font-size:20px;letter-spacing:-.01em}
.entree span{color:var(--doux);font-size:15px;text-wrap:pretty}
.entree em{margin-top:auto;padding-top:12px;font-style:normal;font-weight:600;font-size:14px;color:var(--accent);display:inline-flex;align-items:center;gap:6px}
.accueil h2{margin:0 0 6px;font-size:20px}
.recents{list-style:none;margin:0;padding:0;border-bottom:1px solid var(--trait)}
.recent{display:flex;align-items:stretch;border-top:1px solid var(--trait)}
.recent-ouvrir{flex:1;min-width:0;display:grid;grid-template-columns:auto minmax(0,1fr) auto auto auto;align-items:center;gap:6px 14px;padding:12px 6px;min-height:64px;border:0;background:none;text-align:left;border-radius:10px}
.recent-ouvrir:hover{background:var(--survol)}
.recent .vignette{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;background:var(--survol);color:var(--doux)}
.recent .nom{font-weight:620;display:block;overflow-wrap:anywhere}
.recent .sous{color:var(--faible);font-size:13.5px;display:block;overflow-wrap:anywhere}
.recent .quand{color:var(--faible);font-size:13px;white-space:nowrap}
.recent .montant{font-variant-numeric:tabular-nums;font-weight:600;font-size:14px;min-width:92px;text-align:right}
.recent-menu{width:44px;border:0;background:none;color:var(--faible);border-radius:10px;display:grid;place-items:center}
.recent-menu:hover{background:var(--survol);color:var(--encre)}
.vide-acc{padding:26px 6px;color:var(--faible)}
@media (max-width:640px){
  .acc-haut{margin-bottom:22px}
  .recent-ouvrir{grid-template-columns:auto minmax(0,1fr) auto}
  .recent .quand,.recent .montant{display:none}
  .entree{min-height:150px;padding:18px}
}

/* ── 4. ÉDITEUR ── */
.editeur{height:100%;display:flex;flex-direction:column;background:var(--fond)}
.barre{flex:none;display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:8px;min-height:54px;padding:6px max(16px,env(safe-area-inset-right,0px)) 6px max(16px,env(safe-area-inset-left,0px));border-bottom:1px solid var(--trait);background:var(--barre);-webkit-backdrop-filter:blur(22px) saturate(160%);backdrop-filter:blur(22px) saturate(160%);position:relative;z-index:20}
.b-gauche,.b-centre,.b-droite{display:flex;align-items:center;gap:4px;min-width:0}
.b-droite{justify-content:flex-end}
@media (min-width:1280px){.barre{grid-template-columns:minmax(0,1fr) auto auto}}   /* grand écran : la colonne de droite ne prend que ses boutons, le nom du document reçoit le reste */
.b-gauche .nom-w{display:flex;align-items:center;gap:8px;min-width:0;flex:1}
.nom-doc{min-width:0;flex:1 1 280px;max-width:520px;height:34px;padding:0 8px;border:1px solid transparent;border-radius:var(--r-s);background:transparent;font-weight:650;font-size:15px;text-overflow:ellipsis}
.nom-doc:hover{background:var(--survol)}
.nom-doc:focus{background:var(--surf);border-color:var(--accent);outline:none}
.enreg{font-size:12.5px;color:var(--faible);white-space:nowrap;display:inline-flex;align-items:center;gap:5px}
.enreg.alerte{color:var(--rouge);font-weight:600}
.enreg .ic{width:14px;height:14px}
.enreg.garder{color:var(--rouge);font-weight:600}
.pts-mini{width:6px;height:6px;border-radius:50%;background:var(--accent);animation:pt 1.1s ease-in-out infinite}
.sep{width:1px;height:20px;background:var(--trait2);margin:0 6px;flex:none}
.corps{flex:1;min-height:0;display:flex}
.bureau{position:relative;flex:1;min-width:0;overflow:auto;scrollbar-gutter:stable;background:var(--bureau);overscroll-behavior:contain;padding:30px max(16px,env(safe-area-inset-right,0px)) 120px max(16px,env(safe-area-inset-left,0px));-webkit-overflow-scrolling:touch}
.pile{width:max-content;min-width:100%}
.cadre{margin:0 auto 28px;width:calc(794px*var(--s,1));height:calc(1123px*var(--s,1));flex:none}
.panneau{flex:none;width:300px;border-left:1px solid var(--trait);background:var(--surf);display:flex;flex-direction:column;min-height:0}
.pan-onglets{display:flex;gap:2px;padding:10px 12px 0;border-bottom:1px solid var(--trait)}
.pan-onglets button{flex:1;min-height:38px;border:0;border-bottom:2px solid transparent;background:none;font-weight:600;font-size:14px;color:var(--faible)}
.pan-onglets button[aria-selected="true"]{color:var(--encre);border-bottom-color:var(--accent)}
.pan-corps{flex:1;overflow:auto;padding:16px}
.pan-vide{color:var(--faible);font-size:14px;text-wrap:pretty}
.barre-bas{display:none}
.tel-seul{display:none}
html[data-app] #b-plus.peut-suppr{display:inline-flex}      /* à l'ordinateur, le menu « ⋯ » n'existe que pour supprimer un BROUILLON : le reste de ses gestes est déjà dans la barre */
/* Entre 761 et 1100 px la barre n'a plus la place de tout dire sur une ligne : les gestes passent en icônes (chacun a un nom accessible),
   le nom du document prend la ligne du haut et son état (Brouillon · Enregistré) la ligne du dessous, comme le titre d'un document de Pages. */
@media (max-width:1100px){
  .b-droite .bt .lib{display:none}.b-droite .bt.primaire .lib{display:inline}
  .b-gauche>.bt .lib{display:none}
  .sep{margin:0 3px}
}
@media (max-width:1360px){ .b-droite .bt.opt-bt .lib{display:none} }
@media (min-width:761px) and (max-width:1100px){
  .barre{grid-template-columns:minmax(0,1fr) auto auto}
  .b-gauche .nom-w{display:grid;grid-template-columns:auto minmax(0,1fr);grid-template-areas:"nom nom" "pill enreg";align-items:center;gap:0 8px}
  .nom-w .nom-doc{grid-area:nom;flex:none;width:100%;height:28px}
  .nom-w #pill-etat{grid-area:pill;height:18px;padding:0 8px;font-size:11.5px}
  .nom-w .enreg{grid-area:enreg;font-size:11.5px;min-width:0}
  .nom-w .enreg:not(.alerte):not(.garder) .txt{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}   /* l'icône dit « enregistré » ; le texte reste lu par les lecteurs d'écran */
}
@media (max-width:900px){.panneau{display:none}.b-centre #b-inserer .lib{display:none}}
@media (max-width:760px){
  .barre{grid-template-columns:minmax(0,1fr) auto;min-height:50px}
  .b-centre{display:none}
  .b-droite>*{display:none!important}
  .b-droite>.tel-seul{display:inline-flex!important}
  .b-gauche .bt .lib{display:none}
  .nom-doc{font-size:16px;flex:1 1 auto}
  .enreg .txt{display:none}
  .bureau{padding-top:16px;padding-bottom:calc(96px + env(safe-area-inset-bottom,0px))}
  .barre-bas{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:25;gap:4px;justify-content:space-around;padding:8px max(16px,env(safe-area-inset-right,0px)) calc(8px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px));background:var(--barre);-webkit-backdrop-filter:blur(22px) saturate(160%);backdrop-filter:blur(22px) saturate(160%);border-top:1px solid var(--trait)}
  .barre-bas .bt{flex:1;flex-direction:column;gap:2px;font-size:11.5px;min-height:48px}
  .barre-bas .bt.primaire{flex:1.2}
}

/* ── 5. PAPIER : la feuille A4 (794 × 1123 px, soit 96 dpi). Elle reste BLANCHE de jour comme de nuit. ── */
.papier{
  --p-encre:#18202f; --p-doux:#566078; --p-faible:#667085; --p-trait:#dfe3ea; --p-fond:#ffffff; --p-accent:#0a5fc2;
  --c:#1b3a6b; --c-tint:color-mix(in srgb,var(--c) 10%,#fff); --c-soft:color-mix(in srgb,var(--c) 6%,#fff);
  --pf:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --fs:13px; --mx:60px; --mt:56px; --mb:80px; --logo:52px; --zx:0px; --bar:148px; --c2:#8a4b08; --pt:var(--pf);
  --st-titre-f:var(--pt); --st-titre-s:1.55; --st-titre-w:650; --st-titre-c:var(--c); --st-titre-e:-.01; --st-titre-t:none;
  --st-sous-titre-f:var(--pt); --st-sous-titre-s:1.18; --st-sous-titre-w:620; --st-sous-titre-c:var(--p-encre); --st-sous-titre-e:0; --st-sous-titre-t:none;
  --st-corps-f:var(--pf); --st-corps-s:1; --st-corps-w:400; --st-corps-c:var(--p-encre); --st-corps-e:0; --st-corps-t:none;
  --st-legende-f:var(--pf); --st-legende-s:.84; --st-legende-w:400; --st-legende-c:var(--p-doux); --st-legende-e:0; --st-legende-t:none;
  font-family:var(--pf);font-size:var(--fs);line-height:1.45;color:var(--p-encre);font-variant-numeric:tabular-nums;color-scheme:light;
}
.feuille{position:relative;width:794px;height:1123px;background:#fff;box-shadow:var(--ombre-feuille);border-radius:2px;overflow:hidden;transform-origin:0 0;transform:scale(var(--s,1))}
.feuille .zone{position:absolute;left:calc(var(--mx) + var(--zx));right:var(--mx);top:var(--mt);height:calc(1123px - var(--mt) - var(--mb))}
.pied{font-size:.78em;line-height:1.35;color:var(--p-doux);display:flex;justify-content:space-between;align-items:flex-end;gap:16px}
.feuille .pied{position:absolute;left:calc(var(--mx) + var(--zx));right:var(--mx);bottom:max(20px,calc(var(--mb) - 50px))}
.pied .pied-m{flex:1;min-width:0}
.pied .pied-n{white-space:nowrap;font-variant-numeric:tabular-nums}
/* la zone de mesure : même largeur, hors écran, jamais affichée — la pagination lit ses hauteurs */
#mesure{position:absolute;left:-12000px;top:0;width:calc(794px - 2*var(--mx) - var(--zx,0px));visibility:hidden;pointer-events:none}

/* blocs : espacement PROPRE à chaque bloc (padding), jamais de marge — la hauteur mesurée est la hauteur réelle */
.bloc{position:relative;padding:6px 0}
.ed{position:relative;outline:none;min-height:1.45em;overflow-wrap:anywhere;word-break:normal;cursor:text}
.ed .l{min-height:1.45em}
.ed.une{white-space:nowrap;overflow:hidden;text-overflow:clip}
.edit .ed.vide::before{content:attr(data-ph);position:absolute;left:0;top:0;color:var(--p-faible);white-space:nowrap;pointer-events:none;font-weight:400;font-style:normal}
.ed.inv{color:#b0263c;text-decoration:underline wavy #b0263c;text-underline-offset:3px}
.ed.puces .l{display:list-item;list-style:disc outside;margin-left:1.3em}
.edit .bloc:hover:not(.sel){outline:1px solid color-mix(in srgb,var(--p-accent) 34%,transparent);outline-offset:3px;border-radius:2px}
.edit .bloc.sel{outline:1.5px solid var(--p-accent);outline-offset:3px;border-radius:2px}
.glisse .bloc.glissant{opacity:.35}
.glisse,.glisse *{cursor:grabbing!important;user-select:none}

/* texte */
.t-texte{padding:5px 0}
.bloc.cont.t-texte,.bloc.cont.t-article{padding-top:2px}
.st-titre{padding-top:14px}
.st-sous-titre{padding-top:10px}
.fmt-gras{font-weight:700!important}.fmt-ital{font-style:italic}.fmt-soul{text-decoration:underline}
.al-centre{text-align:center}.al-droite{text-align:right}.al-justifie{text-align:justify}

/* en-tête de l'entreprise */
.t-entete{padding:2px 0 8px}
.ent{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:6px 18px;align-items:center}
.ent-logo{--lg-fond:var(--c);--lg-texte:#fff;line-height:0}
.ent-logo svg{width:var(--logo);height:var(--logo);display:block}
/* les initiales du logo sont du texte DANS un SVG que la page met à l'échelle (transform, --s) : sans cette ligne Chromium garde la mise en page du texte à l'échelle d'avant (« CS » minuscule dans un coin du carré, « 17 » absent) quand on passe d'« Ajuster » à 100 % */
svg[role="img"] text{text-rendering:geometricPrecision}
.ent-id b{display:block;font-size:1.35em;line-height:1.2;color:var(--c);letter-spacing:-.01em}
.ent-id span{display:block;color:var(--p-doux);font-size:.92em}
.ent-coord{text-align:right;font-size:.88em;color:var(--p-doux);line-height:1.5}
.ent-coord span{display:block}
.ent-coord b{font-weight:600;color:var(--p-encre)}
.papier[data-logo="non"] .ent-logo{display:none}
.papier[data-logo="non"] .ent{grid-template-columns:minmax(0,1fr) auto}
.papier[data-logo-al="centre"] .ent{grid-template-columns:minmax(0,1fr);justify-items:center;text-align:center}
.papier[data-logo-al="centre"] .ent-coord{text-align:center}
.papier[data-logo-al="droite"] .ent-logo{order:3}
.papier[data-logo-al="droite"] .ent{grid-template-columns:minmax(0,1fr) auto auto}
.papier[data-logo-al="droite"] .ent-coord{order:2}
.papier[data-logo-t="s"]{--logo:38px}.papier[data-logo-t="m"]{--logo:52px}.papier[data-logo-t="l"]{--logo:80px}

/* cartouche, client, objet */
.t-cartouche{padding:8px 0 4px}
.ct{display:flex;justify-content:space-between;align-items:flex-end;gap:16px}
.ct-titre{font-size:1.9em;font-weight:700;letter-spacing:.14em;color:var(--c);line-height:1.1}
.ct-meta{text-align:right;line-height:1.55}
.ct-meta .ligne{display:flex;justify-content:flex-end;gap:8px;align-items:baseline}
.ct-meta .ligne>span{color:var(--p-doux)}
.ct-meta .ligne{flex-wrap:wrap}
.ct-meta .ed{display:inline-block;min-width:3ch;min-height:0;font-weight:600;white-space:nowrap}
.ct-meta .ed .l{min-height:0}
.ct-meta .fin{font-size:.88em;color:var(--p-doux)}
.ct-date{display:inline-block;border:0;background:none;padding:0;margin:0;font:inherit;line-height:inherit;font-weight:600;color:inherit;cursor:pointer;border-bottom:1px dashed transparent}
.edit .ct-date{border-bottom-color:var(--p-faible)}
.t-client{padding:8px 0}
.cl{padding:12px 14px;border:1px solid var(--p-trait);border-radius:8px;width:56%;margin-left:auto;line-height:1.5;overflow-wrap:anywhere;min-width:0}
.cl small{display:block;font-size:.76em;letter-spacing:.1em;text-transform:uppercase;color:var(--p-doux);margin-bottom:2px;font-weight:600}
.cl b{display:block;font-size:1.04em}
.cl span{display:block;color:var(--p-doux);font-size:.94em;overflow-wrap:anywhere}
.cl span.cl-choisir{display:inline-block}
.cl .vide-cl{color:var(--p-faible);font-style:italic}
.cl-choisir{display:inline-block;margin-top:4px;padding:3px 10px;border-radius:999px;border:1px dashed var(--p-accent);color:var(--p-accent);font-size:.9em;font-weight:600;line-height:1.45}
.papier:not(.edit) .cl-choisir{border-color:transparent;color:var(--p-faible);font-style:italic;font-weight:400}
.t-objet{padding:8px 0}
.objet{display:flex;gap:8px;align-items:baseline}
.objet>b{flex:none;color:var(--c)}
.objet .ed{flex:1;min-width:0;font-weight:600}

/* tableau de prix */
.t-tableau{padding:8px 0}
.tab{width:100%;border-collapse:separate;border-spacing:0;table-layout:fixed;font-size:.92em}
.tab th{position:relative;font-weight:600;text-align:left;padding:7px 8px;font-size:.88em;color:var(--c);border-bottom:1.5px solid var(--c);line-height:1.25;vertical-align:bottom}
.tab td{padding:7px 8px;border-bottom:1px solid var(--p-trait);vertical-align:top;position:relative;line-height:1.45}
.tab .num{text-align:right}
.tab td.num .ed{text-align:right}
.tab td.num{overflow-wrap:anywhere}
.tab tr.sec td{font-weight:650;background:var(--c-soft);border-bottom:1px solid color-mix(in srgb,var(--c) 22%,#fff)}
.tab tr.sec .sous{font-variant-numeric:tabular-nums;white-space:normal;overflow-wrap:anywhere}      /* « Sous-total » puis le montant : si les deux colonnes sont étroites, le montant passe SOUS le mot, il ne sort jamais de la feuille */
.tab tr.sec .sous i{font-style:normal;font-weight:500;color:var(--p-doux);margin-right:6px;white-space:nowrap}
.tab tr.sec .sous i::after{content:"\200B"}   /* une coupure possible ENTRE le mot et le montant : sans elle, c'est le « € » qui passait seul à la ligne */
.tab tr.opt td{color:var(--p-doux)}
.tab tr.opt .tot-l{font-style:italic}
.tab[data-bandes="oui"] tr.lg:nth-child(even) td{background:var(--c-soft)}
.des-w{display:flex;gap:8px;align-items:flex-start}
.des-w .ed{flex:1;min-width:0}
.tag-opt{flex:none;margin-top:1px;padding:0 7px;border-radius:999px;border:1px solid var(--p-trait);font-size:.78em;line-height:1.7;color:var(--p-doux);font-weight:600;background:#fff}
.rt{position:absolute;top:50%;transform:translateY(-50%);width:22px;height:26px;display:flex;align-items:center;justify-content:center;border:0;border-radius:6px;background:transparent;color:#6b7489;opacity:0;padding:0;line-height:0}
.rt:hover{background:rgba(11,20,38,.08);color:#18202f}
.rt .ic{width:15px;height:15px}
.rt-grip{left:-28px;cursor:grab;touch-action:none}
.rt-menu{right:-28px}
.edit .tab tr:hover .rt,.edit .tab tr:focus-within .rt,.rt:focus-visible{opacity:1}
.edit .tab tr:focus-within td{background:color-mix(in srgb,var(--p-accent) 6%,#fff)}
@media (pointer:coarse){.edit .tab tr.lg .rt{opacity:.6}}

/* totaux */
.t-totaux{padding:6px 0}
.tot{width:48%;margin-left:auto}
.tot .lg{display:flex;justify-content:space-between;gap:12px;padding:3px 0;line-height:1.4}
.tot .lg>span{color:var(--p-doux)}
.tot .lg>b{font-weight:600;white-space:nowrap}
.tot .lg.sub{font-size:.9em;padding:2px 0}
.tot .lg.sous-trait{border-top:1px solid var(--p-trait);margin-top:4px;padding-top:7px}
.tot .lg.ttc{border-top:1.5px solid var(--c);margin-top:6px;padding-top:8px;font-size:1.12em}
.tot .lg.ttc>span{color:var(--p-encre);font-weight:700}
.tot .lg.ttc>b{font-weight:700;color:var(--c)}
.tot .lg.reste>b{color:var(--c)}
.tot .lg.note{font-size:.84em;color:var(--p-doux);font-style:italic;justify-content:flex-start}
.tot .lg.note>span{color:inherit}

/* conditions, signature, encadré, photo, trait, saut, article */
.t-conditions{padding:8px 0}
.cond h4{margin:0 0 4px;font-size:.84em;letter-spacing:.1em;text-transform:uppercase;color:var(--c)}
.cond .rg{display:flex;gap:10px;padding:3px 0}
.cond .rg>b{flex:none;width:76px;font-weight:600;color:var(--p-doux)}
.cond .rg>div,.cond .rg>.ed{flex:1;min-width:0}
.t-signature{padding:10px 0}
.sg{border:1px solid var(--p-trait);border-radius:8px;padding:10px 14px}
.sg-tit .ed{font-weight:700;color:var(--c)}
.sg-cons .ed{color:var(--p-doux);font-size:.9em}
.sg-cadres{display:flex;gap:14px;margin-top:8px}
.sg-un{flex:1;min-width:0}
.sg-role{display:block;font-size:.84em;color:var(--p-doux);margin-bottom:4px;font-weight:600}
.sg-zone{height:58px;border:1px dashed #b9c0cf;border-radius:6px;display:flex;align-items:center;justify-content:center;overflow:hidden}
.sg-zone svg{width:100%;height:100%}
.sg-date{display:block;margin-top:4px;font-size:.82em;color:var(--p-doux)}
.t-encadre{padding:8px 0}
.bloc.cont.t-encadre{padding-top:2px}
.enc{padding:10px 14px;border-radius:8px}
.enc.fond-tint{background:var(--c-tint)}.enc.fond-neutre{background:#f2f4f8}
.enc.bord{border:1px solid color-mix(in srgb,var(--c) 40%,#fff)}
.t-photo{padding:8px 0}
.ph{margin:0}
.ph.al-gauche{margin-right:auto}.ph.al-centre{margin-inline:auto}.ph.al-droite{margin-left:auto}
.ph img{display:block;width:100%;height:auto;max-height:calc(1123px - var(--mt) - var(--mb) - 110px);object-fit:contain}
.ph.coins-doux img,.ph.coins-doux .ph-vide{border-radius:8px}.ph.coins-ronds img,.ph.coins-ronds .ph-vide{border-radius:22px}
.ph-vide{height:150px;border:1px dashed #b9c0cf;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;color:var(--p-faible);background:#f8f9fb}
.ph-vide .ic{width:26px;height:26px}
.papier:not(.edit) .ph-vide{border-color:transparent;background:transparent;color:transparent}
.ph figcaption{margin-top:5px}
.ph figcaption .ed{font-size:.84em;color:var(--p-doux);text-align:center}
.t-trait{padding:10px 0}
.t-trait hr{border:0;border-top:1px solid var(--p-trait);margin:0}
.t-saut{padding:0}
.saut-m{height:24px;display:flex;align-items:center;gap:10px;color:var(--p-faible);font-size:.78em;letter-spacing:.08em;text-transform:uppercase}
.saut-m::before,.saut-m::after{content:"";flex:1;border-top:1px dashed #b9c0cf}
.papier:not(.edit) .saut-m{visibility:hidden}
.t-article{padding:8px 0}
.art-t{display:flex;gap:8px;align-items:baseline;font-weight:650}
.art-t .art-n{flex:none;color:var(--c)}
.art-t .ed{flex:1;min-width:0}
.art-c .ed{margin-top:2px}

/* ── 6. MODÈLES (le même contenu, quatre mises en page) ── */
/* Classique : filet de couleur sous l'en-tête, titres en capitales fines */
.papier[data-modele="classique"] .ent{padding-bottom:12px;border-bottom:2px solid var(--c)}
/* Moderne : titre grand, barre de couleur, tableau à en-tête teinté */
.papier[data-modele="moderne"] .ent-id b{font-size:1.55em;letter-spacing:-.02em}
.papier[data-modele="moderne"] .ct-titre{font-size:2.5em;letter-spacing:-.02em;font-weight:700;border-left:5px solid var(--c);padding-left:12px;line-height:1.05}
.papier[data-modele="moderne"] .tab th{background:var(--c-tint);border-bottom:0;padding:9px 8px}
.papier[data-modele="moderne"] .tab th:first-child{border-radius:7px 0 0 7px}.papier[data-modele="moderne"] .tab th:last-child{border-radius:0 7px 7px 0}
.papier[data-modele="moderne"] .cl{background:var(--c-soft);border-color:transparent;border-radius:10px}
.papier[data-modele="moderne"] .tot .lg.ttc{background:var(--c);color:#fff;border-radius:8px;padding:9px 12px;margin-top:8px;border-top:0}
.papier[data-modele="moderne"] .tot .lg.ttc>span,.papier[data-modele="moderne"] .tot .lg.ttc>b{color:#fff}
/* Épuré : presque rien — traits très fins, capitales minuscules */
.papier[data-modele="epure"] .ent-id b{font-size:1.2em;font-weight:500;color:var(--p-encre)}
.papier[data-modele="epure"] .ct-titre{font-size:1.7em;font-weight:300;letter-spacing:.2em;color:var(--p-encre)}
.papier[data-modele="epure"] .tab th{color:var(--p-doux);font-weight:600;text-transform:uppercase;letter-spacing:.08em;font-size:.72em;border-bottom:1px solid var(--p-trait)}
.papier[data-modele="epure"] .tab tr.sec td{background:transparent;border-bottom:1px solid var(--p-trait);color:var(--c)}
.papier[data-modele="epure"] .tab td{border-bottom-color:#eceff4}
.papier[data-modele="epure"] .cl{border:0;border-left:2px solid var(--p-trait);border-radius:0;padding:2px 0 2px 14px}
.papier[data-modele="epure"] .tot .lg.ttc{border-top:1px solid var(--p-encre)}
/* Bandeau : bandeau de couleur pleine largeur en haut de la première page */
.papier[data-modele="bandeau"] .t-entete.prem{position:relative;z-index:0;padding:18px 0 16px;color:#fff}
.papier[data-modele="bandeau"] .t-entete.prem::before{content:"";position:absolute;z-index:-1;left:calc(-1*var(--mx));right:calc(-1*var(--mx));top:calc(-1*var(--mt));bottom:0;background:var(--c)}
.papier[data-modele="bandeau"] .t-entete.prem .ent-id b,.papier[data-modele="bandeau"] .t-entete.prem .ent-id span,.papier[data-modele="bandeau"] .t-entete.prem .ent-coord,.papier[data-modele="bandeau"] .t-entete.prem .ent-coord b{color:#fff}
.papier[data-modele="bandeau"] .t-entete.prem .ent-logo{--lg-fond:#fff;--lg-texte:var(--c)}
.papier[data-modele="bandeau"] .ct-titre{font-size:1.7em}
.papier[data-modele="bandeau"] .t-entete:not(.prem){border-bottom:2px solid var(--c)}

/* ── 6b. MODÈLES 5 à 8, STYLES DE TEXTE, TABLEAU PERSONNALISABLE, PIED, FILIGRANE ──
   Un modèle ne fait QUE poser des valeurs par défaut (variables CSS et quelques règles). Ce que la personne règle (couleurs, polices, styles,
   tableau) est écrit en ligne sur la feuille ou sur le tableau et passe toujours devant : « Revenir au style du modèle » n'a qu'à retirer ce réglage. */
.ent-id b,.ct-titre,.cond h4,.art-t,.sg-tit .ed,.objet>b{font-family:var(--pt)}
.ent-logo img{display:block;height:var(--logo);width:auto;max-width:220px;object-fit:contain}
.papier[data-modele="epure"]{--st-titre-w:500}
/* Colonne : une colonne de couleur à gauche sur toutes les pages ; le logo et les coordonnées y sont posés (première page) */
.papier[data-modele="bandeau"] .t-entete.prem .ent-logo img{box-sizing:content-box;height:calc(var(--logo) - 12px);background:#fff;padding:6px;border-radius:9px}   /* un logo sombre reste lisible sur le bandeau */
.papier[data-modele="colonne"]{--zx:calc(var(--bar) + 26px - var(--mx))}
.papier[data-modele="colonne"] .feuille::before{content:"";position:absolute;z-index:0;left:0;top:0;bottom:0;width:var(--bar);background:var(--c)}
.papier[data-modele="colonne"] .t-entete.prem{height:0;padding:0;z-index:2;outline:none!important}
.papier[data-modele="colonne"] .t-entete.prem .ent{position:absolute;left:calc(-1*(var(--mx) + var(--zx)));top:calc(-1*var(--mt));width:var(--bar);padding:36px 14px 0;display:flex;flex-direction:column;align-items:flex-start;gap:12px;text-align:left;color:#fff}
.papier[data-modele="colonne"][data-logo-al="centre"] .t-entete.prem .ent{align-items:center;text-align:center}
.papier[data-modele="colonne"][data-logo-al="droite"] .t-entete.prem .ent{align-items:flex-end;text-align:right}
.papier[data-modele="colonne"] .t-entete.prem .ent-id,.papier[data-modele="colonne"] .t-entete.prem .ent-coord{text-align:inherit;order:0}
.papier[data-modele="colonne"] .t-entete.prem .ent-logo{order:0}
.papier[data-modele="colonne"] .t-entete.prem .ent-id b,.papier[data-modele="colonne"] .t-entete.prem .ent-id span,.papier[data-modele="colonne"] .t-entete.prem .ent-coord,.papier[data-modele="colonne"] .t-entete.prem .ent-coord b{color:#fff}
.papier[data-modele="colonne"] .t-entete.prem .ent-id b{font-size:1.12em;overflow-wrap:anywhere}
.papier[data-modele="colonne"] .t-entete.prem .ent-id span,.papier[data-modele="colonne"] .t-entete.prem .ent-coord{font-size:.8em;line-height:1.45;overflow-wrap:anywhere}
.papier[data-modele="colonne"] .t-entete.prem .ent-logo{--lg-fond:#fff;--lg-texte:var(--c)}
.papier[data-modele="colonne"] .t-entete.prem .ent-logo img{box-sizing:content-box;height:calc(var(--logo) - 12px);max-width:calc(var(--bar) - 40px);background:#fff;padding:6px;border-radius:9px}
.papier[data-modele="colonne"] .t-entete:not(.prem){border-bottom:2px solid var(--c)}
.papier[data-modele="colonne"] .ct-titre{border-left:5px solid var(--c);padding-left:12px;font-size:2.2em;line-height:1.05}
.papier[data-modele="colonne"] .tab th,.papier[data-modele="colonne"] .tab td{padding-left:5px;padding-right:5px}
.papier[data-modele="colonne"] .tab tr.sec .sous{white-space:normal}   /* le contenu est plus étroit : le sous-total passe à la ligne au lieu de dépasser du tableau */
.edit.papier[data-modele="colonne"] .t-entete.prem.sel .ent{outline:2px solid #fff;outline-offset:-5px}
/* Aplat : un grand aplat de couleur en tête de la première page, le mot DEVIS (ou CONTRAT) en réserve, en blanc */
.papier[data-modele="aplat"] .t-entete.prem{position:relative;z-index:0;height:104px;padding:20px 0 0;color:#fff}
.papier[data-modele="aplat"] .t-entete.prem::before{content:"";position:absolute;z-index:-1;left:calc(-1*var(--mx));right:calc(-1*var(--mx));top:calc(-1*var(--mt));height:calc(var(--mt) + 104px);background:var(--c)}
.papier[data-modele="aplat"] .t-entete.prem:has(+ .t-cartouche)::before{height:calc(var(--mt) + 104px + 124px)}
.papier[data-modele="aplat"] .t-entete.prem .ent-id b,.papier[data-modele="aplat"] .t-entete.prem .ent-id span,.papier[data-modele="aplat"] .t-entete.prem .ent-coord,.papier[data-modele="aplat"] .t-entete.prem .ent-coord b{color:#fff}
.papier[data-modele="aplat"] .t-entete.prem .ent-logo{--lg-fond:#fff;--lg-texte:var(--c)}
.papier[data-modele="aplat"] .t-entete.prem .ent-logo img{box-sizing:content-box;height:calc(var(--logo) - 12px);background:#fff;padding:6px;border-radius:9px}
.papier[data-modele="aplat"] .t-entete.prem + .t-cartouche{height:124px;padding:0 0 22px;display:flex;align-items:flex-end;color:#fff}
.papier[data-modele="aplat"] .t-entete.prem + .t-cartouche .ct{width:100%}
.papier[data-modele="aplat"] .t-entete.prem + .t-cartouche .ct-titre{color:#fff;font-size:3.1em;font-weight:800;letter-spacing:.07em;line-height:1}
.papier[data-modele="aplat"] .t-entete.prem + .t-cartouche .ct-meta,.papier[data-modele="aplat"] .t-entete.prem + .t-cartouche .ct-meta .ligne>span,.papier[data-modele="aplat"] .t-entete.prem + .t-cartouche .ct-meta .fin,.papier[data-modele="aplat"] .t-entete.prem + .t-cartouche .ct-meta .ed{color:#fff}
.papier[data-modele="aplat"] .t-entete.prem + .t-cartouche .ct-date{border-bottom-color:rgba(255,255,255,.7)}
.papier[data-modele="aplat"] .t-entete:not(.prem){border-bottom:2px solid var(--c)}
.papier[data-modele="aplat"] .tab th{background:var(--c-tint);border-bottom:0}
.papier[data-modele="aplat"] .tot .lg.ttc{border-top:2px solid var(--c2)}
/* Élégant : en-tête centré entre deux filets, titres à empattements, tableau à filets fins */
.papier[data-modele="elegant"]{--st-titre-w:500;--st-titre-e:.01}
.papier[data-modele="elegant"] .ent{grid-template-columns:minmax(0,1fr);justify-items:center;text-align:center;gap:8px;padding:8px 0 16px;border-bottom:3px double var(--c2)}
.papier[data-modele="elegant"][data-logo-al="gauche"] .ent{justify-items:start;text-align:left}
.papier[data-modele="elegant"][data-logo-al="droite"] .ent{justify-items:end;text-align:right}
.papier[data-modele="elegant"] .ent-logo,.papier[data-modele="elegant"] .ent-coord{order:0}
.papier[data-modele="elegant"] .ent-id b{font-weight:500;font-size:1.5em;letter-spacing:.16em;text-transform:uppercase}
.papier[data-modele="elegant"] .ent-coord{text-align:inherit;display:flex;flex-wrap:wrap;justify-content:center;gap:0 16px;font-size:.84em}
.papier[data-modele="elegant"][data-logo-al="gauche"] .ent-coord{justify-content:flex-start}
.papier[data-modele="elegant"][data-logo-al="droite"] .ent-coord{justify-content:flex-end}
.papier[data-modele="elegant"] .ct-titre{font-weight:400;font-size:1.55em;letter-spacing:.32em;text-transform:uppercase;color:var(--c)}
.papier[data-modele="elegant"] .t-cartouche .ct{padding-bottom:10px;border-bottom:1px solid var(--p-trait)}
.papier[data-modele="elegant"] .tab th{color:var(--c);font-weight:600;text-transform:uppercase;letter-spacing:.1em;font-size:.72em;border-bottom:1px solid var(--c)}
.papier[data-modele="elegant"] .tab td{border-bottom-color:#e8ebf1}
.papier[data-modele="elegant"] .tab tr.sec td{background:transparent;font-family:var(--pt);font-style:italic;color:var(--c);border-bottom:1px solid var(--p-trait)}
.papier[data-modele="elegant"] .cl{border:0;border-top:1px solid var(--c);border-bottom:1px solid var(--p-trait);border-radius:0;padding:8px 0}
.papier[data-modele="elegant"] .tot .lg.ttc{border-top:3px double var(--c2);padding-top:10px}
.papier[data-modele="elegant"] .cond h4{letter-spacing:.2em}
/* Technique : compact, grille serrée, beaucoup de lignes par page */
.papier[data-modele="technique"] .bloc{padding-top:4px;padding-bottom:4px}
.papier[data-modele="technique"] .ent{padding-bottom:8px;border-bottom:2px solid var(--c);gap:4px 14px}
.papier[data-modele="technique"] .ent-id b{font-size:1.2em}
.papier[data-modele="technique"] .t-cartouche .ct{padding:8px 12px;border:1px solid var(--c)}
.papier[data-modele="technique"] .ct-titre{font-size:1.5em;letter-spacing:.1em}
.papier[data-modele="technique"] .cl{border:1px solid var(--c);border-radius:0;padding:7px 10px}
.papier[data-modele="technique"] .cl small{color:var(--c)}
.papier[data-modele="technique"] .tab{--gr:color-mix(in srgb,var(--c) 30%,#cfd5e0)}
.papier[data-modele="technique"] .tab th{background:var(--c-tint);color:var(--c);border-top:1px solid var(--gr);border-right:1px solid var(--gr);border-bottom:1px solid var(--c);padding:4px 6px;font-size:.82em;text-transform:uppercase;letter-spacing:.04em}
.papier[data-modele="technique"] .tab th:first-child,.papier[data-modele="technique"] .tab td:first-child{border-left:1px solid var(--gr)}
.papier[data-modele="technique"] .tab td{padding:3px 6px;line-height:1.3;border-bottom:1px solid var(--gr);border-right:1px solid var(--gr)}
.papier[data-modele="technique"] .tab .ed,.papier[data-modele="technique"] .tab .ed .l{min-height:1.3em}
.papier[data-modele="technique"] .tab tr.sec td{background:var(--c-tint);color:var(--c)}
.papier[data-modele="technique"] .tot .lg{padding:2px 0}
.papier[data-modele="technique"] .tot .lg.ttc{background:var(--c-tint);padding:5px 8px;border-top:1px solid var(--c)}

/* les quatre styles de texte : police, taille (multiple du corps), graisse, couleur, capitales, espacement — des variables, modifiables par modèle ET par document */
.st-titre .ed{font-family:var(--st-titre-f);font-size:calc(var(--st-titre-s)*1em);line-height:1.25;font-weight:var(--st-titre-w);color:var(--st-titre-c);letter-spacing:calc(var(--st-titre-e)*1em);text-transform:var(--st-titre-t)}
.st-sous-titre .ed{font-family:var(--st-sous-titre-f);font-size:calc(var(--st-sous-titre-s)*1em);line-height:1.3;font-weight:var(--st-sous-titre-w);color:var(--st-sous-titre-c);letter-spacing:calc(var(--st-sous-titre-e)*1em);text-transform:var(--st-sous-titre-t)}
.st-corps .ed{font-family:var(--st-corps-f);font-size:calc(var(--st-corps-s)*1em);font-weight:var(--st-corps-w);color:var(--st-corps-c);letter-spacing:calc(var(--st-corps-e)*1em);text-transform:var(--st-corps-t)}
.st-legende .ed{font-family:var(--st-legende-f);font-size:calc(var(--st-legende-s)*1em);font-weight:var(--st-legende-w);color:var(--st-legende-c);letter-spacing:calc(var(--st-legende-e)*1em);text-transform:var(--st-legende-t)}

/* tableau : ce que la personne règle passe devant le modèle (auto = on ne pose rien) */
.col-r{position:absolute;right:-6px;top:0;bottom:0;width:12px;z-index:3;cursor:col-resize;touch-action:none;outline:none}
.col-r::after{content:"";position:absolute;left:5px;top:18%;bottom:18%;width:2px;border-radius:1px;background:var(--p-accent);opacity:0;transition:opacity .12s}
.col-r:hover::after,.col-r:focus-visible::after,.col-r.actif::after{opacity:.9}
body.col-glisse,body.col-glisse *{cursor:col-resize!important;user-select:none}
.papier:not(.edit) .col-r{display:none}
.papier .tab[data-th="plein"] th{background:var(--c);color:#fff;border-bottom:0;border-radius:0}
.papier .tab[data-th="plein"] th:first-child{border-radius:7px 0 0 7px}.papier .tab[data-th="plein"] th:last-child{border-radius:0 7px 7px 0}
.papier .tab[data-th="filet"] th{background:transparent;color:var(--c);border-bottom:1.5px solid var(--c);border-radius:0}
.papier .tab[data-th="doux"] th{background:var(--c-tint);color:var(--c);border-bottom:0;border-radius:0}
.papier .tab[data-th="doux"] th:first-child{border-radius:7px 0 0 7px}.papier .tab[data-th="doux"] th:last-child{border-radius:0 7px 7px 0}
.papier .tab[data-tr="lignes"]{--gr:var(--p-trait)}
.papier .tab[data-tr="lignes"] td{border-bottom:1px solid var(--p-trait);border-right:0;border-left:0}
.papier .tab[data-tr="lignes"] th{border-right:0;border-left:0;border-top:0}
.papier .tab[data-tr="grille"]{--gr:color-mix(in srgb,var(--c) 28%,#cfd5e0)}
.papier .tab[data-tr="grille"] td{border-bottom:1px solid var(--gr);border-right:1px solid var(--gr)}
.papier .tab[data-tr="grille"] td:first-child,.papier .tab[data-tr="grille"] th:first-child{border-left:1px solid var(--gr)}
.papier .tab[data-tr="grille"] th{border-top:1px solid var(--gr);border-right:1px solid var(--gr)}
.papier .tab[data-tr="aucun"] td,.papier .tab[data-tr="aucun"] tr.sec td{border-bottom:0;border-right:0;border-left:0}
.papier .tab[data-dn="compacte"] td{padding:3px 6px;line-height:1.3}.papier .tab[data-dn="compacte"] th{padding:4px 6px}
.papier .tab[data-dn="compacte"] .ed,.papier .tab[data-dn="compacte"] .ed .l{min-height:1.3em}
.papier .tab[data-dn="normale"] td{padding:7px 8px;line-height:1.45}.papier .tab[data-dn="normale"] th{padding:7px 8px}
.papier .tab[data-dn="aeree"] td{padding:12px 10px}.papier .tab[data-dn="aeree"] th{padding:12px 10px}
.papier .tab[data-bx="oui"]{--rd:8px;--cf:color-mix(in srgb,var(--c) 32%,#d5dae3)}
.papier .tab[data-bx="oui"][data-co="ronds"]{--rd:16px}
.papier .tab[data-bx="oui"] th{border-top:1px solid var(--cf)}
.papier .tab[data-bx="oui"] th:first-child{border-left:1px solid var(--cf);border-top-left-radius:var(--rd)}
.papier .tab[data-bx="oui"] th:last-child{border-right:1px solid var(--cf);border-top-right-radius:var(--rd)}
.papier .tab[data-bx="oui"] td:first-child{border-left:1px solid var(--cf)}
.papier .tab[data-bx="oui"] td:last-child{border-right:1px solid var(--cf)}
.papier .tab[data-bx="oui"] tbody tr:last-child td{border-bottom:1px solid var(--cf)}
.papier .tab[data-bx="oui"] tbody tr:last-child td:first-child{border-bottom-left-radius:var(--rd)}
.papier .tab[data-bx="oui"] tbody tr:last-child td:last-child{border-bottom-right-radius:var(--rd)}

/* filigrane : toujours DERRIÈRE le contenu (il est le premier enfant de la feuille ; la zone et le pied passent devant) */
.filig{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;overflow:hidden;z-index:0}
.filig span{display:block;white-space:nowrap;font-family:var(--pt);font-weight:800;text-transform:uppercase;color:var(--c);letter-spacing:.06em;line-height:1;opacity:var(--fo,.12);transform:rotate(var(--fa,-32deg))}
.feuille .zone,.feuille .pied{z-index:1}
/* pied de page : jusqu'à trois lignes, numéro à gauche, au centre, à droite */
.pied .pied-l{display:block}
.pied[data-num="gauche"] .pied-n{order:-1}
.pied[data-num="centre"]{flex-direction:column;align-items:stretch;gap:2px}
.pied[data-num="centre"] .pied-n{text-align:center}
.pied.pied-mes{position:static;width:100%}

/* ── 7. OUTILS FLOTTANTS : menus, bulles, glisser, notifications ── */
#couche{position:fixed;inset:0;pointer-events:none;z-index:50}
#couche>*{pointer-events:auto}
.menu,.pop{position:fixed;z-index:60;background:var(--surf);border:1px solid var(--trait2);border-radius:14px;box-shadow:var(--ombre-haute);padding:6px;min-width:210px;max-width:min(380px,calc(100vw - 24px));max-height:min(720px,calc(100% - 76px));overflow:auto;animation:apparait .16s var(--ressort)}
.menu button{display:flex;align-items:center;gap:10px;width:100%;min-height:40px;padding:0 10px;border:0;background:none;border-radius:8px;text-align:left;font-size:14.5px}
.menu button:hover,.menu button:focus-visible{background:var(--survol);outline:none}
.menu button[disabled]{opacity:.4;cursor:default}
.menu button .coche{margin-left:auto;color:var(--accent);width:16px;height:16px}
.menu button small{margin-left:auto;color:var(--faible);font-size:12.5px}
.menu hr{border:0;border-top:1px solid var(--trait);margin:5px 4px}
.menu .tit{padding:6px 10px 2px;font-size:12px;font-weight:650;letter-spacing:.06em;text-transform:uppercase;color:var(--faible)}
.pop{padding:14px;min-width:260px}
.pop h3{margin:0 0 8px;font-size:15px}
.pop p{margin:0 0 8px;color:var(--doux);font-size:14px;text-wrap:pretty}
.champ{display:flex;flex-direction:column;gap:4px;margin-bottom:10px;font-size:13px;color:var(--doux);font-weight:550}
.champ input,.champ select{min-height:40px;padding:0 10px;border:1px solid var(--trait2);border-radius:9px;background:var(--surf2);font-size:16px;font-weight:450;color:var(--encre)}
.champ input:focus,.champ select:focus{outline:2px solid var(--accent);outline-offset:0;border-color:transparent}
.champ .err{color:var(--rouge);font-weight:550;font-size:13px}
.pop .rangee{display:flex;gap:8px;justify-content:flex-end;margin-top:6px}
.pop .deux{display:grid;grid-template-columns:1fr 1fr;gap:8px;align-items:start}
.seg{display:flex;padding:2px;border-radius:9px;background:var(--survol);border:1px solid var(--trait)}
.seg button{flex:1;min-height:32px;border:0;border-radius:7px;background:none;font-size:13px;font-weight:600;color:var(--doux)}
.seg button[aria-pressed="true"]{background:var(--surf);color:var(--encre);box-shadow:var(--ombre-seg)}
.liste-clients{display:flex;flex-direction:column;gap:2px;margin:0 -6px 8px}
.liste-clients button{display:flex;flex-direction:column;align-items:flex-start;gap:0;padding:7px 10px;min-height:48px;border:0;background:none;border-radius:8px;text-align:left}
.liste-clients button:hover,.liste-clients button:focus-visible{background:var(--survol);outline:none}
.liste-clients b{font-size:14.5px}.liste-clients span{font-size:12.5px;color:var(--faible)}
.liste-clients b,.liste-clients span{max-width:100%;overflow-wrap:anywhere}
.suggest{position:fixed;z-index:61;background:var(--surf);border:1px solid var(--trait2);border-radius:12px;box-shadow:var(--ombre-haute);padding:5px;min-width:320px;max-width:min(460px,calc(100vw - 24px));animation:apparait .14s var(--ressort)}
.suggest [role="option"]{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 12px;padding:7px 10px;border-radius:8px;cursor:pointer;font-size:14px}
.suggest [role="option"][aria-selected="true"],.suggest [role="option"]:hover{background:var(--accent-fond)}
.suggest small{color:var(--faible);font-size:12.5px}
.suggest .p{font-variant-numeric:tabular-nums;font-weight:600;text-align:right}
.bulle{position:fixed;z-index:62;max-width:min(320px,calc(100vw - 24px));padding:9px 12px;border-radius:10px;background:var(--rouge);color:var(--on-rouge);font-size:13.5px;line-height:1.35;box-shadow:var(--ombre-haute);animation:apparait .14s var(--ressort)}
.voile{position:fixed;inset:0;background:var(--voile);z-index:70;display:flex;align-items:center;justify-content:center;padding:16px;pointer-events:auto}
.dialogue{width:min(420px,100%);background:var(--surf);border-radius:var(--r-l);box-shadow:var(--ombre-haute);padding:22px;animation:apparait .18s var(--ressort)}
.dialogue h3{margin:0 0 6px;font-size:18px}.dialogue p{margin:0 0 16px;color:var(--doux);text-wrap:pretty}
.dialogue .rangee{display:flex;gap:8px;justify-content:flex-end}
#toasts{position:fixed;left:0;right:0;bottom:calc(22px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;align-items:center;gap:8px;z-index:80;pointer-events:none;padding:0 16px}
@media (max-width:760px){ body.menu-ouvert #toasts{visibility:hidden} }      /* au téléphone un menu ouvert couvre presque tout l'écran : les infobulles (« Modèle posé · Annuler ») ne se posent pas par-dessus ses gestes */
.toast{pointer-events:none;display:flex;align-items:center;gap:14px;max-width:min(520px,100%);padding:10px 14px;border-radius:12px;background:var(--encre);color:var(--fond);font-size:14px;box-shadow:var(--ombre-haute);animation:monte .2s var(--ressort)}
.toast span{min-width:0;overflow-wrap:anywhere}
body.fen-ouverte #toasts,body.ap-ouvert #toasts{top:calc(12px + env(safe-area-inset-top,0px));bottom:auto}
.toast button{pointer-events:auto;border:0;background:none;color:inherit;font-weight:700;text-decoration:underline;padding:4px 10px;min-height:44px}
@media (max-width:760px){#toasts{bottom:calc(88px + env(safe-area-inset-bottom,0px))}}

/* poignée et barre d'actions du bloc sélectionné (posées sur le bureau, jamais dans la feuille) */
#poignee{position:absolute;z-index:15;width:26px;height:32px;display:flex;align-items:center;justify-content:center;border:0;border-radius:8px;background:var(--surf);color:var(--doux);box-shadow:var(--ombre);cursor:grab;touch-action:none;padding:0}
#poignee:hover{color:var(--accent)}
#actions{position:absolute;z-index:16;display:flex;align-items:center;gap:2px;padding:3px;border-radius:11px;background:var(--surf);border:1px solid var(--trait2);box-shadow:var(--ombre-haute);max-width:calc(100% - 16px);flex-wrap:nowrap}
#actions .bt{min-height:32px;padding:0 9px;font-size:13px;gap:6px}
#actions .bt .ic{width:15px;height:15px}
#actions .sep{height:16px;margin:0 3px}
#actions .bt.verrou{color:var(--faible)}
@media (max-width:760px){#actions .bt span{display:none}#actions .bt{min-width:44px;min-height:44px;padding:0 10px}#actions .sep{height:22px}}
#depot{position:fixed;z-index:65;height:0;border-top:2px solid var(--accent);pointer-events:none;border-radius:2px}
#depot::before,#depot::after{content:"";position:absolute;top:-5px;width:8px;height:8px;border-radius:50%;background:var(--accent)}
#depot::before{left:-4px}#depot::after{right:-4px}

/* ── 8. PASSE 2 : panneau Format, fenêtres et feuilles du bas, interrupteurs, aperçu, vue client, signature, téléphone ── */
@keyframes feuille{from{transform:translateY(100%)}to{transform:none}}
.enc.fond-aucun{background:transparent}
.champ textarea{min-height:92px;padding:10px;border:1px solid var(--trait2);border-radius:9px;background:var(--surf2);font-size:16px;font-weight:450;color:var(--encre);resize:vertical;line-height:1.4}
.champ textarea:focus{outline:2px solid var(--accent);outline-offset:0;border-color:transparent}
.champ input[aria-invalid="true"],.champ textarea[aria-invalid="true"]{border-color:var(--rouge)}
.champ .err[hidden]{display:none}
.champ .aide{font-weight:400;font-size:12.5px;color:var(--faible)}

/* interrupteur (case à cocher en bascule) */
.interr{display:flex;align-items:center;gap:10px;min-height:38px;cursor:pointer;font-size:14px;color:var(--encre);font-weight:500}
.interr input{appearance:none;-webkit-appearance:none;flex:none;width:38px;height:22px;border-radius:999px;background:var(--trait2);position:relative;transition:background .15s;margin:0;cursor:pointer}
.interr input::after{content:"";position:absolute;left:2px;top:2px;width:18px;height:18px;border-radius:50%;background:var(--bouton-blanc);box-shadow:var(--ombre-bouton);transition:transform .15s var(--ressort)}
.interr input:checked{background:var(--accent)}
:root[data-theme="dark"] .interr input:checked{background:var(--accent)}
.interr input:checked::after{transform:translateX(16px)}
.interr input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.interr input:disabled{opacity:.4;cursor:default}
.interr input:disabled+span{opacity:.55}
.interr.haut{align-items:flex-start;padding-top:2px}.interr.haut input{margin-top:2px}
.interr small{display:block;margin-top:1px;font-weight:400;font-size:12.5px;color:var(--faible);text-wrap:pretty}
.nv-client .fen-corps{padding-top:10px}
.nv-dbl{margin-top:14px;padding:12px 14px;border-radius:12px;background:var(--surf2);border:1px solid var(--trait2);border-left:4px solid var(--accent)}
.nv-dbl p{margin:0 0 10px;font-size:14.5px;line-height:1.4;overflow-wrap:anywhere}
.nv-dbl .bt{width:100%;max-width:100%;overflow-wrap:anywhere}

/* fenêtres : centrées au bureau, feuille du bas au téléphone */
.voile.fen-v{align-items:center}
.fenetre{position:relative;width:min(540px,100%);max-height:min(88%,780px);display:flex;flex-direction:column;background:var(--surf);border-radius:var(--r-l);box-shadow:var(--ombre-haute);animation:apparait .18s var(--ressort);color:var(--encre)}
.fenetre.large{width:min(760px,100%)}
.fen-tete{flex:none;display:flex;align-items:center;gap:8px;padding:14px 12px 6px 20px}
.fen-tete h3{margin:0;font-size:18px;flex:1;min-width:0;text-wrap:balance}
.fen-corps{flex:1;min-height:0;overflow:auto;padding:6px 20px 14px;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
.fen-pied{flex:none;display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;padding:12px 20px calc(14px + env(safe-area-inset-bottom,0px));border-top:1px solid var(--trait)}
.fen-x{position:absolute;right:8px;top:8px;z-index:2}
.fen-corps>h3{margin:12px 0 8px;padding-right:44px}
.fen-liste{display:flex;flex-direction:column;margin:0 -8px}
.fen-ligne{display:flex;align-items:center;gap:14px;width:100%;min-height:52px;padding:0 12px;border:0;border-radius:12px;background:none;text-align:left;font-size:16.5px;color:var(--encre)}
.fen-ligne:hover{background:var(--survol)}
.fen-ligne .ic{width:21px;height:21px;color:var(--doux)}
.fen-ligne small{margin-left:auto;color:var(--faible);font-size:13.5px}
.fen-ligne.danger,.fen-ligne.danger .ic{color:var(--rouge)}
.fen-ligne:disabled{opacity:.4}
.fen-ligne .qt{margin-left:auto;font-variant-numeric:tabular-nums;color:var(--doux);font-size:14.5px;white-space:nowrap}
.fen-ligne.sec{font-weight:650}
.fen-ligne .des{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fen-sep{border:0;border-top:1px solid var(--trait);margin:6px 0}
.fen-note{margin:0 0 12px;color:var(--doux);font-size:14px;text-wrap:pretty}
.fen-note.ambre{padding:10px 12px;border-radius:10px;background:color-mix(in srgb,var(--ambre) 13%,transparent);color:var(--encre)}
.fen-note.ambre ul{margin:4px 0 0;padding-left:18px}
.fen-note.exemple{font-size:13px;color:var(--faible)}
.sug-liste{display:flex;flex-direction:column;gap:2px;margin:-4px 0 10px}
.sug-btn{display:flex;justify-content:space-between;gap:10px;align-items:center;min-height:44px;padding:6px 12px;border:1px solid var(--trait);border-radius:10px;background:var(--surf2);text-align:left;font-size:14.5px}
.sug-btn span:last-child{font-variant-numeric:tabular-nums;font-weight:600;white-space:nowrap}
.fen-grille{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.puce-ia{display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:999px;background:var(--accent-fond);color:var(--accent);font-size:12px;font-weight:650}
.liste-modeles{display:flex;flex-direction:column;gap:2px;margin:0 -8px 10px}
.modele-l{display:flex;align-items:center;gap:6px}
.modele-l .ouvre{flex:1;min-width:0;display:flex;flex-direction:column;align-items:flex-start;gap:0;min-height:56px;padding:8px 12px;border:0;border-radius:12px;background:none;text-align:left}
.modele-l .ouvre:hover{background:var(--survol)}
.modele-l .ouvre b{font-size:15px;font-weight:620}
.modele-l .ouvre span{font-size:13px;color:var(--faible)}
.modele-l .ouvre .sw{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;vertical-align:-1px}
.titre-pt{margin:14px 0 4px;font-size:12px;font-weight:650;letter-spacing:.06em;text-transform:uppercase;color:var(--faible)}
@media (max-width:760px){
  .voile.fen-v{align-items:flex-end;padding:0}
  .fenetre,.fenetre.large{width:100%;max-width:none;max-height:90%;border-radius:20px 20px 0 0;animation:feuille .26s var(--ressort)}
  .fen-tete::before{content:"";position:absolute;left:50%;top:6px;width:38px;height:5px;margin-left:-19px;border-radius:3px;background:var(--trait2)}
  .fen-tete{padding-top:20px}
  .fen-corps{padding-left:max(18px,env(safe-area-inset-left,0px));padding-right:max(18px,env(safe-area-inset-right,0px))}
  .fen-pied{padding-left:max(18px,env(safe-area-inset-left,0px));padding-right:max(18px,env(safe-area-inset-right,0px))}
  .fen-pied .bt{flex:1}
  .interr{min-height:48px;font-size:15.5px}
  .interr input{width:46px;height:28px}.interr input::after{width:24px;height:24px}.interr input:checked::after{transform:translateX(18px)}
  .interr input::before{content:"";position:absolute;left:0;right:0;top:-8px;bottom:-8px}      /* la bascule elle-même répond sur 46 × 44 px, pas seulement la ligne qui l'entoure */
}
.voile.souple{background:transparent;pointer-events:none;align-items:flex-end;padding:0}
.voile.souple .fenetre{pointer-events:auto;width:100%;max-width:none;max-height:min(58%,500px);border-radius:20px 20px 0 0;border:1px solid var(--trait2);border-bottom:0;animation:feuille .26s var(--ressort)}
.voile.souple .fen-tete{padding:12px 10px 0 12px}
.voile.souple .pan-onglets{flex:1;padding:0;border:0}

/* panneau Format */
.pg{margin:0 0 22px}
.pg h4{margin:0 0 8px;font-size:12px;font-weight:650;letter-spacing:.06em;text-transform:uppercase;color:var(--faible)}
.pg .seg{width:100%}
.pg .seg.g2{display:grid;grid-template-columns:1fr 1fr;gap:2px}
.pg .note{margin:6px 0 0;font-size:12.5px;color:var(--faible);text-wrap:pretty}
.pg .err{margin:6px 0 0;font-size:13px;color:var(--rouge);font-weight:550}
.pg .btn-l{display:flex;width:100%;justify-content:flex-start;margin-bottom:4px;white-space:normal;text-align:left;overflow-wrap:anywhere;height:auto;padding-top:6px;padding-bottom:6px}
.pg .sous{margin:12px 0 6px;font-size:13px;font-weight:600;color:var(--doux)}
.pan-bloc-t{display:flex;align-items:center;gap:8px;margin:0 0 16px;font-size:15px;flex-wrap:wrap}
.pan-bloc-t .pill{gap:4px}.pan-bloc-t .pill .ic{width:13px;height:13px}
.vign{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.vig{display:flex;flex-direction:column;gap:6px;align-items:center;padding:8px 6px 6px;border:1.5px solid var(--trait);border-radius:12px;background:var(--surf2);font-size:12.5px;font-weight:600;color:var(--doux)}
.vig svg{width:auto;height:108px;display:block;border-radius:3px;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.18)}
.vig[aria-pressed="true"]{border-color:var(--accent);color:var(--accent);background:var(--accent-fond)}
.pastilles{display:flex;flex-wrap:wrap;gap:10px}
.pas{position:relative;width:30px;height:30px;border-radius:50%;border:0;padding:0;background:var(--pc);box-shadow:inset 0 0 0 1px rgba(0,0,0,.2);flex:none}
.pas[aria-pressed="true"]{box-shadow:0 0 0 2px var(--surf),0 0 0 4px var(--accent)}
.pas.libre{background:conic-gradient(#e0475b,#e8a33d,#6cc04a,#3ab4c8,#5a67d8,#b05fcf,#e0475b);overflow:hidden;cursor:pointer}
.pas.libre input{position:absolute;inset:0;opacity:0;width:100%;height:100%;cursor:pointer;padding:0;border:0}
.pas.auto{background:var(--surf2);display:grid;place-items:center;color:var(--doux);font-size:11px;font-weight:700}
.polices{display:flex;flex-direction:column;gap:6px}
.pol{display:flex;align-items:center;gap:12px;min-height:44px;padding:0 12px;border:1.5px solid var(--trait);border-radius:10px;background:var(--surf2);text-align:left;font-size:15px}
.pol i{font-style:normal;font-size:20px;width:30px;color:var(--encre)}
.pol span{font-size:13.5px;color:var(--doux);font-family:var(--police)}
.pol[aria-pressed="true"]{border-color:var(--accent);background:var(--accent-fond)}
.pan-corps input[type="range"],.fen-corps input[type="range"]{width:100%;accent-color:var(--accent);min-height:32px;margin:0}
.val{float:right;font-variant-numeric:tabular-nums;color:var(--doux);font-weight:600}
.tbar{display:flex;gap:4px;flex-wrap:wrap}
.tbar .bt{border:1px solid var(--trait2);background:var(--surf2)}
.tbar .bt[aria-pressed="true"]{border-color:var(--accent)}
.pan-corps .champ,.fen-corps .champ{margin-bottom:12px}

/* aperçu plein écran */
.apercu{position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;background:var(--bureau)}
.apercu[hidden]{display:none}
.ap-barre{flex:none;display:flex;align-items:center;gap:12px;flex-wrap:wrap;min-height:56px;padding:6px max(16px,env(safe-area-inset-right,0px)) 6px max(16px,env(safe-area-inset-left,0px));border-bottom:1px solid var(--trait);background:var(--barre);-webkit-backdrop-filter:blur(22px) saturate(160%);backdrop-filter:blur(22px) saturate(160%)}
.ap-tit{display:flex;flex-direction:column;line-height:1.2;min-width:0;flex:1}
.ap-tit b{font-size:15px}.ap-tit span{font-size:12.5px;color:var(--faible)}
.ap-sw{margin-left:auto}
.ap-corps{flex:1;min-height:0;overflow:auto;overflow-x:hidden;scrollbar-gutter:stable;padding:24px max(16px,env(safe-area-inset-right,0px)) 40px max(16px,env(safe-area-inset-left,0px));-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
.ap-pile{width:100%}
.ap-pile .cadre:last-child{margin-bottom:0}
@media (max-width:760px){
  .ap-barre{gap:6px 10px;padding-bottom:2px}
  .ap-sw{order:3;flex-basis:100%;margin-left:0}
  .ap-corps{padding-top:14px}
}

/* « ce que voit le client » : un téléphone, la page que le client reçoit par le lien */
.tel-cadre{--t-fond:#f3f5f9;--t-encre:#18202f;--t-doux:#566078;--t-trait:#dfe3ea;--t-acc:#0a5fc2;
  position:relative;width:min(392px,100%);height:min(100%,800px);margin:0 auto;border:10px solid #0d1320;border-radius:44px;background:var(--t-fond);overflow:hidden;box-shadow:var(--ombre-haute);display:flex;flex-direction:column;color:var(--t-encre);color-scheme:light;font-family:var(--police)}
.tel-ecran{flex:1;min-height:0;overflow:auto;scrollbar-gutter:stable;padding:0 0 12px;-webkit-overflow-scrolling:touch;background:var(--t-fond)}
.cl-tete{display:flex;align-items:center;gap:10px;padding:16px 16px 10px}
.cl-tete .lg{width:36px;height:36px;flex:none}.cl-tete .lg svg,.cl-tete .lg img{width:100%;height:100%;display:block;--lg-texte:#fff}.cl-tete .lg img{object-fit:contain}
.cl-tete b{display:block;font-size:15px;line-height:1.2}.cl-tete span{font-size:13px;color:var(--t-doux)}
.cl-carte{margin:0 12px 10px;padding:14px;border-radius:14px;background:#fff;border:1px solid var(--t-trait)}
.cl-carte h2{margin:0 0 4px;font-size:18px;line-height:1.25}
.cl-carte p{margin:0 0 8px;font-size:14px;color:var(--t-doux)}
.cl-carte .ligne{display:flex;justify-content:space-between;gap:10px;font-size:14px;padding:2px 0}
.cl-carte .ligne b{font-variant-numeric:tabular-nums;min-width:0;overflow-wrap:anywhere;text-align:right}
.cl-carte .ligne span{flex:none}
.cl-carte .gros{font-size:17px}
.cl-ruban{margin:0 12px 10px;padding:8px 12px;border-radius:10px;background:#fdeccf;color:#6d4200;font-size:13px}
.cl-ok{margin:0 12px 10px;padding:10px 12px;border-radius:10px;background:#dff3e5;color:#14532b;font-size:14px;font-weight:600}
.cl-loupe{display:flex;justify-content:flex-end;padding:0 12px 6px}
.cl-loupe button{display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:0 12px;border:1px solid var(--t-trait);border-radius:999px;background:#fff;font-size:13px;font-weight:600;color:var(--t-encre)}
.cl-pile{width:max-content;min-width:100%;padding:0 12px}
.cl-pile .cadre{margin:0 auto 12px}
.cl-pile .feuille{box-shadow:0 1px 4px rgba(11,20,38,.18)}
.cl-actions{flex:none;padding:10px 12px calc(12px + env(safe-area-inset-bottom,0px));border-top:1px solid var(--t-trait);background:#fff;display:flex;flex-direction:column;gap:6px}
.cl-btn{min-height:52px;border:0;border-radius:14px;background:var(--t-acc);color:#fff;font-size:17px;font-weight:650}
.cl-btn.sec{background:#fff;color:var(--t-acc);border:1px solid var(--t-trait);min-height:44px;font-size:15px}
.cl-lien{border:0;background:none;color:var(--t-doux);text-decoration:underline;font-size:13px;min-height:44px}
.cl-note{margin:0 0 4px;font-size:13px;line-height:1.4;color:var(--t-doux);text-align:center;text-wrap:pretty}
.cl-btn[aria-disabled="true"]{background:#dfe4ee;color:#4a5469;cursor:default}
.pad-txt label{display:block;margin:2px 0 6px;font-size:14px;color:var(--t-doux)}
.pad-txt input{width:100%;min-height:52px;padding:0 14px;border:1.5px solid #9aa4b8;border-radius:12px;background:#fbfcfe;font-size:20px;color:#18202f;font-style:italic}
.pad-alt{display:block;margin:6px auto 0}
.cl-signer{position:absolute;left:0;right:0;bottom:0;z-index:5;max-height:92%;overflow:auto;padding:16px 16px calc(14px + env(safe-area-inset-bottom,0px));background:#fff;border-radius:22px 22px 0 0;box-shadow:0 -10px 40px rgba(11,20,38,.28);animation:feuille .26s var(--ressort)}
.cl-signer h3{margin:0 0 6px;font-size:18px}
.cl-case{display:flex;gap:10px;align-items:flex-start;margin:10px 0;font-size:15px;min-height:44px}
.cl-case input{width:22px;height:22px;margin:1px 0 0;accent-color:var(--t-acc);flex:none}
.pad-w{position:relative;border:1.5px dashed #76819a;border-radius:12px;background:#fbfcfe;height:170px;overflow:hidden}
.pad{width:100%;height:100%;display:block;touch-action:none;cursor:crosshair}
.pad path{fill:none;stroke:#18202f;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
.pad-ph{position:absolute;inset:0;display:grid;place-items:center;color:#5a6379;font-size:15px;pointer-events:none}
.cl-signer .err{margin:8px 0 0;min-height:22px;color:#b0263c;font-size:14px;font-weight:600;line-height:1.4}
.cl-signer .rangee{display:flex;gap:8px;margin-top:12px}
.cl-signer .rangee button{flex:1;min-height:48px;border-radius:12px;border:1px solid var(--t-trait);background:#fff;font-size:15.5px;font-weight:600;color:var(--t-encre)}
.cl-signer .rangee .cl-btn{flex:2;color:#fff;border:0;background:var(--t-acc)}
@media (max-width:760px){
  .tel-cadre{border:0;border-radius:0;height:100%;width:100%;box-shadow:none}
  .ap-corps.ap-tel{padding:0}
}

/* téléphone : la feuille se lit en entier, on retouche au toucher */
@media (max-width:760px){
  #poignee,#actions{display:none!important}
  .edit .bloc:hover:not(.sel){outline:0}
  .edit .bloc{-webkit-tap-highlight-color:transparent;cursor:pointer}
  .bureau{scrollbar-gutter:auto}
}
body.fmt-bas #toasts{bottom:calc(min(58%,500px) + 12px)}
@media (pointer:coarse),(max-width:760px){
  .pas{width:44px;height:44px}.pastilles{gap:8px}
  .vig{min-height:44px}
  .seg button{min-height:44px;font-size:14px}
  .pg .seg{padding:3px}
  .pg .btn-l,.tbar .bt{min-height:44px}
  .tbar .bt{min-width:44px}
  .pol{min-height:52px}
  .pan-corps input[type="range"],.fen-corps input[type="range"]{min-height:44px}
  .fen-corps .champ input,.fen-corps .champ select{min-height:48px}
  .sug-btn{min-height:48px}
}

.fen-corps .deux{display:grid;grid-template-columns:1fr 1fr;gap:8px;align-items:start}   /* un message d'erreur sous un champ ne décale pas son voisin */
.env-pj{display:flex;align-items:center;gap:10px;padding:6px 6px 6px 12px;border:1px solid var(--trait);border-radius:10px;margin:0 0 8px;font-size:14px}
.env-pj span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.env-pj .ic{color:var(--doux)}
#env-go.attention{background:color-mix(in srgb,var(--ambre) 20%,var(--surf));color:var(--encre);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--ambre) 55%,transparent)}
#env-go[aria-busy="true"]{opacity:.7;cursor:progress}
.fenetre:focus{outline:none}
@media (pointer:coarse),(max-width:760px){.nom-doc{height:44px}.b-gauche>.bt{min-width:44px}}
@media (pointer:coarse),(max-width:760px){.menu button{min-height:46px}.menu hr{margin:4px 4px}}
@media (pointer:coarse),(max-width:760px){.pan-onglets button{min-height:44px}}
.champ input,.champ textarea,.champ select{width:100%;min-width:0}
.fen-corps .deux>*,.pop .deux>*{min-width:0}
@media (max-width:760px){
  .vign{grid-template-columns:repeat(3,1fr);gap:8px}
  .vig{padding:6px 2px 4px;font-size:12px}
}
@media (pointer:coarse),(max-width:760px){label.champ{min-height:44px;justify-content:center}}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .pas{box-shadow:inset 0 0 0 1px rgba(255,255,255,.34)}:root:not([data-theme="light"]) .pas[aria-pressed="true"]{box-shadow:0 0 0 2px var(--surf),0 0 0 4px var(--accent)}}
:root[data-theme="dark"] .pas{box-shadow:inset 0 0 0 1px rgba(255,255,255,.34)}:root[data-theme="dark"] .pas[aria-pressed="true"]{box-shadow:0 0 0 2px var(--surf),0 0 0 4px var(--accent)}

/* ── 9. PASSE 3 : contrats (bandeau, panneau, clauses), étiquettes, IA ── */
.corps{position:relative}
.bt.lien{min-height:32px;padding:0 4px;color:var(--accent);font-size:13.5px;font-weight:600}
.bt.lien:hover{background:var(--accent-fond)}
@media (pointer:coarse){.bt.lien{min-height:44px;padding:0 8px}}
.seg.g2{display:grid;grid-template-columns:1fr 1fr;gap:2px}
.champ .seg{margin-top:2px}

/* bandeau juridique : discret et permanent dans l'éditeur de contrat */
.bandeau-droit{flex:none;display:flex;flex-wrap:wrap;align-items:center;gap:2px 12px;padding:5px max(16px,env(safe-area-inset-right,0px)) 5px max(16px,env(safe-area-inset-left,0px));border-bottom:1px solid var(--trait);background:color-mix(in srgb,var(--ambre) 9%,var(--surf));font-size:12.5px;line-height:1.4;color:var(--doux)}
.bandeau-droit>.ic{width:15px;height:15px;color:var(--ambre)}
.bandeau-droit .txt{flex:1 1 240px;min-width:0;text-wrap:pretty}
.bandeau-droit .pill-act{border:0;cursor:pointer;font:inherit;font-weight:650;font-size:12.5px;height:26px;background:color-mix(in srgb,var(--ambre) 20%,transparent);color:var(--ambre-txt)}
.pill-act .court{display:none}
.bandeau-droit .pill-act:hover{background:color-mix(in srgb,var(--ambre) 30%,transparent)}
@media (pointer:coarse){.bandeau-droit .pill-act{min-height:44px;padding:0 14px}}
/* au téléphone : une seule rangée — l'icône, la phrase entière (sur deux lignes au plus) et la pastille raccourcie */
@media (max-width:760px){
  .bandeau-droit{flex-wrap:nowrap;gap:6px;padding-top:4px;padding-bottom:4px;font-size:11.5px}
  .bandeau-droit>.ic{width:13px;height:13px}
  .bandeau-droit .txt{flex:1 1 0}
  .pill-act .long{display:none}.pill-act .court{display:inline}
  .bandeau-droit .pill-act{flex:none;padding:0 8px;font-size:12px}
}

/* étiquettes de variables dans la feuille — jamais de largeur ni de graisse qui change : seules couleur et ombre */
.var-chip{display:inline;padding:0;border-radius:4px;background:var(--c-tint);color:var(--c);box-shadow:0 0 0 2px var(--c-tint);-webkit-box-decoration-break:clone;box-decoration-break:clone;font-weight:inherit;font-size:inherit}
.edit .var-chip{cursor:pointer}
.papier:not(.edit) .var-chip:not(.manque){background:none;color:inherit;box-shadow:none}
.var-chip.manque{background:#fdeccf;color:#7a4600;box-shadow:0 0 0 2px #fdeccf}

/* pastille « Écrit par l'IA — à relire » : posée en absolu sur la feuille, jamais dans le flux (la pagination ne la voit pas) */
.ia-tag{position:absolute;right:0;top:-9px;z-index:3;display:inline-flex;align-items:center;gap:4px;height:17px;padding:0 7px 0 5px;border:0;border-radius:999px;background:#e4eeff;color:#0a4aa0;font:600 10.5px/1 var(--pf);white-space:nowrap;cursor:pointer}
.ia-tag svg{width:11px;height:11px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.ia-tag:hover{background:#d3e3ff}
span.ia-tag{cursor:default;pointer-events:none}
.t-article>.ia-tag{top:9px}        /* un article : sur la ligne de son titre, pour qu'on voie à quel article elle appartient */

/* panneau « Contrat » */
.titre-ml{margin:0 0 6px;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ambre)}
.ac-carte{padding:12px 14px;border-radius:12px;background:color-mix(in srgb,var(--ambre) 11%,transparent)}
.ac-carte .note{margin:0 0 6px;color:var(--doux)}
.manque-l,.ac-l{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:1px}
.manque-l li>*{display:flex;align-items:center;gap:8px;width:100%;min-height:34px;text-align:left;border:0;background:none;padding:2px 4px;border-radius:7px;font-size:14px;color:var(--encre)}
.manque-l button:hover{background:var(--survol)}
.manque-l li>*::before{content:"";flex:none;width:6px;height:6px;border-radius:50%;background:var(--ambre)}
@media (pointer:coarse){.manque-l li>*{min-height:44px}}
.ac-l .interr{min-height:34px;font-weight:450}
.ac-l .fait{text-decoration:line-through;color:var(--faible)}
.ok-ligne{display:flex;align-items:center;gap:8px;margin:0;color:var(--vert);font-size:14px;font-weight:600}
.manque-carte:has(.ok-ligne){background:color-mix(in srgb,var(--vert) 10%,transparent)}
.clause{padding:8px 0;border-top:1px solid var(--trait)}
.clause:first-of-type{border-top:0}
.clause .interr{min-height:36px;font-weight:600}
@media (pointer:coarse),(max-width:760px){.clause .interr,.ac-l .interr{min-height:48px}}
.clause .note{margin:0 0 4px 48px}
.clause>.bt.lien{margin-left:44px}
.clause-lire{margin-left:48px}
.clause-lire summary{display:flex;align-items:center;min-height:32px;cursor:pointer;color:var(--accent);font-size:13.5px;font-weight:600;list-style:none}
.clause-lire summary::-webkit-details-marker{display:none}
.clause-lire p{margin:2px 0 6px;white-space:pre-line;font-size:13px;line-height:1.45;color:var(--doux);text-wrap:pretty}
@media (pointer:coarse){.clause-lire summary{min-height:44px}.clause .note,.clause-lire{margin-left:56px}.clause>.bt.lien{margin-left:48px}}
.chips-ins{display:flex;flex-wrap:wrap;gap:6px}
.chip-i{min-height:32px;max-width:100%;padding:0 11px;border:1px solid var(--trait2);border-radius:999px;background:var(--surf2);font-size:13px;font-weight:550;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chip-i:hover{border-color:var(--accent);color:var(--accent)}
@media (pointer:coarse){.chip-i{min-height:44px;padding:0 14px}}
.ia-relire{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin:0 0 10px}
.ia-btns .bt{flex:1 1 auto}
.ia-clause{margin:12px 0 8px}
.ia-raison{margin-top:8px}
.puce-ia svg{width:13px;height:13px}

/* entrée « Contrats » et feuille « Créer avec l'IA » */
.ia-hero{display:flex;align-items:center;gap:14px;width:100%;min-height:78px;margin:6px 0 4px;padding:14px 16px;border:1.5px solid color-mix(in srgb,var(--accent) 50%,transparent);border-radius:var(--r);background:var(--accent-fond);text-align:left;color:var(--encre)}
.ia-hero:hover{border-color:var(--accent)}
.ia-hero>.ic:first-child{width:26px;height:26px;color:var(--accent)}
.ia-hero span{flex:1;min-width:0}
.ia-hero b{display:block;font-size:17px}
.ia-hero small{display:block;margin-top:2px;font-size:13.5px;color:var(--doux);text-wrap:pretty}
.ia-hero>.ic:last-child{color:var(--accent)}
.fen-corps .champ textarea{min-height:120px}
.champ textarea[data-var],.fen-corps .champ textarea[data-var]{min-height:62px;overflow:hidden;resize:none}

/* la barre « L'IA rédige… » : au-dessus de la page, jamais dans la feuille */
#ia-bar{position:absolute;z-index:30;left:12px;right:12px;top:12px;margin:0 auto;width:max-content;display:flex;align-items:center;gap:10px;max-width:calc(100% - 24px);padding:6px 6px 6px 14px;border-radius:18px;background:var(--surf);border:1px solid var(--trait2);box-shadow:var(--ombre-haute);font-size:14px;font-weight:550;animation:apparait .18s var(--ressort)}
#ia-bar[hidden]{display:none}
/* ── optimiser un devis avec l'IA ── */
.opt-bt[hidden]{display:none!important}
.opt-bt.grise{opacity:.55}
.opt-bt .ic{color:var(--accent)}
.barre-bas .opt-bt{min-width:0}
.ia-opt .fen-corps{padding-top:10px}
.opt-choix{display:grid;gap:2px;margin:0 0 12px}
.opt-cons{display:block;margin:6px 0 4px;font-size:14px;font-weight:550}
.opt-cons small{font-weight:400;color:var(--faible)}
.opt-cons input{display:block;width:100%;margin-top:6px;min-height:44px;padding:0 12px;border:1px solid var(--trait2);border-radius:var(--r-s);background:var(--surf2);color:var(--encre);font:inherit;font-size:16px}
.opt-travail{display:flex;align-items:center;gap:12px;padding:22px 0 8px;font-size:15px;font-weight:600}
.opt-fam h4,.opt-rem h4,.opt-ec h4{margin:18px 0 8px;font-size:13px;letter-spacing:.02em;text-transform:uppercase;color:var(--faible)}
.opt-fam h4 small{margin-left:8px;padding:1px 7px;border-radius:999px;background:var(--accent-fond);color:var(--accent);font-size:12px}
.opt-ch{display:flex;gap:12px;align-items:flex-start;margin:0 0 8px;padding:10px 12px;border:1px solid var(--trait);border-radius:var(--r);background:var(--surf2);cursor:pointer}
.opt-ch input{flex:none;width:22px;height:22px;margin:2px 0 0;accent-color:var(--accent)}
.opt-cadre{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:6px 14px;min-width:0;flex:1;font-size:14px}
.opt-t{grid-column:1/-1;font-size:12.5px;font-weight:650;color:var(--faible)}
.opt-av,.opt-ap{min-width:0;overflow-wrap:anywhere;text-wrap:pretty}
.opt-l{display:block;margin-bottom:2px;font-style:normal;font-size:11.5px;font-weight:650;letter-spacing:.03em;text-transform:uppercase;color:var(--faible)}
.opt-av del{color:var(--faible);text-decoration:line-through}
.opt-ap ins{text-decoration:none;background:var(--accent-fond);border-radius:4px;padding:0 3px;box-decoration-break:clone;-webkit-box-decoration-break:clone}
.opt-vide{color:var(--faible);font-style:italic}
.opt-plan,.opt-plan ul{margin:0;padding-left:18px}.opt-plan>li{margin:0 0 6px}.opt-plan ul{color:var(--doux);font-size:13px}
.opt-rem ul,.opt-ec ul{margin:0;padding-left:20px;display:grid;gap:4px;font-size:14px;overflow-wrap:anywhere}
.opt-note{margin:0 0 6px;font-size:13px;color:var(--faible)}
.opt-long{white-space:pre-line}
.opt-var{font-weight:600;border-bottom:1.5px dotted var(--doux)}
.opt-av .opt-var{font-weight:inherit}
.opt-var.manque{font-style:italic}
.opt-pleine{grid-column:1/-1}.opt-l2{margin-top:8px}
.opt-ordre{list-style:decimal;padding-left:22px}.opt-ordre li{margin:0 0 3px}
.opt-juri{font-size:13px;color:var(--doux)}
.opt-ec{color:var(--faible)}
@media (max-width:620px){.opt-cadre{grid-template-columns:minmax(0,1fr)}.ia-opt .fen-pied .primaire{order:-1;flex:1 1 100%}.ia-opt .fen-pied .bt{min-height:44px}}

#ia-bar .ia-txt{min-width:0;text-wrap:pretty}
#ia-bar .ia-n{color:var(--faible);font-weight:450;white-space:nowrap}
#ia-bar.err{border-color:var(--rouge);flex-wrap:wrap;padding-top:8px;padding-bottom:8px}
#ia-bar.err .ia-txt{flex:1 1 220px}
.pts{display:inline-flex;gap:3px;flex:none}
.pts i{width:6px;height:6px;border-radius:50%;background:var(--accent);animation:pt 1.1s ease-in-out infinite}
.pts i:nth-child(2){animation-delay:.15s}.pts i:nth-child(3){animation-delay:.3s}
@keyframes pt{0%,100%{opacity:.25}50%{opacity:1}}
body.ia-ecrit .bureau{cursor:progress}
@media (max-width:760px){#ia-bar{top:8px}#ia-bar .ia-n{display:none}}

/* l'envoi : le bouton peut dire ce qui manque, sur plusieurs lignes */
#env-go{white-space:normal;height:auto;min-height:44px;line-height:1.25;padding-top:8px;padding-bottom:8px;text-align:center;max-width:min(380px,100%)}

/* ── 10. PASSE 4 : personnalisation (Mon entreprise, galerie, styles, tableau, pied, filigrane) ── */
.entree .gros img,.entree .gros svg:not(.ic){max-width:34px;max-height:34px;object-fit:contain}
/* galerie de modèles */
.galerie .fen-corps{padding-bottom:20px}
.gal-grille{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px 12px;margin:4px -6px 6px}
.gal-t{display:flex;flex-direction:column;align-items:center;gap:7px;min-width:0;padding:10px 8px 12px;border:1.5px solid transparent;border-radius:14px;background:none;text-align:center;color:var(--encre)}
.gal-suite{display:contents}
.gal-t:hover{background:var(--survol)}
.gal-t:focus-visible{border-color:var(--accent)}
.gal-t b{font-size:14.5px;font-weight:620;overflow-wrap:anywhere}
.gal-t small{font-size:12.5px;color:var(--faible);text-wrap:balance;line-height:1.3}
.gal-mini{display:block;border-radius:3px;overflow:hidden;background:#fff;line-height:0;box-shadow:0 1px 3px rgba(11,20,38,.22),0 8px 20px rgba(11,20,38,.12)}
.gal-p{--s:.26;width:max-content;pointer-events:none;text-align:left}
.gal-p .cadre{margin:0}.gal-p .feuille{box-shadow:none;border-radius:0}
.gal-vide{width:calc(794px*.26);height:calc(1123px*.26);display:grid;place-items:center;background:var(--surf2);box-shadow:inset 0 0 0 1.5px var(--trait2);border-radius:3px}
.gal-plus{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:var(--accent-fond);color:var(--accent)}
.gal-plus .ic{width:24px;height:24px}
@media (max-width:760px){
  .gal-grille{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 6px}
  .gal-p{--s:.2}.gal-vide{width:calc(794px*.2);height:calc(1123px*.2)}
  .gal-t{min-height:44px;padding:8px 4px 10px}
}
/* « Mon entreprise » */
.ident .id-t{margin:20px 0 8px;font-size:12px;font-weight:650;letter-spacing:.06em;text-transform:uppercase;color:var(--faible)}
.ident .id-t:first-of-type{margin-top:6px}
.ident .sous-id{margin:6px 0 6px;font-size:13px;font-weight:600;color:var(--doux)}
.id-logo{display:flex;gap:14px;align-items:center;flex-wrap:wrap}
.id-logo-cadre{width:168px;height:92px;flex:none;display:grid;place-items:center;border:1px dashed var(--trait2);border-radius:12px;background:#fff;overflow:hidden;--lg-fond:#1b3a6b;--lg-texte:#fff}
.id-logo-cadre img{max-width:148px;max-height:74px;width:auto;height:auto;object-fit:contain}
.id-logo-cadre svg{width:64px;height:64px}
.id-logo-act{display:flex;flex-direction:column;gap:6px;align-items:flex-start}
.aide-id{margin:8px 0 4px;font-size:12.5px;color:var(--faible);text-wrap:pretty}
.ident .err{color:var(--rouge);font-weight:550;font-size:13px;margin:4px 0 0}
.ident .champ select{width:100%;min-height:44px;padding:0 10px;border:1px solid var(--trait2);border-radius:9px;background:var(--surf2);font-size:16px;font-weight:450;color:var(--encre)}
.id-prev{padding:12px;border-radius:12px;background:var(--bureau)}
.id-prev .papier{--logo:44px;padding:16px 18px;background:#fff;border-radius:6px;box-shadow:var(--ombre-seg)}
.id-prev .ent{gap:4px 14px}
@media (max-width:760px){.id-prev .papier{padding:14px}.id-prev .ent{grid-template-columns:minmax(0,1fr)!important;justify-items:start;gap:10px}.id-prev .ent-coord{text-align:left!important}.id-prev .ent-id b{font-size:1.25em}}
.ident .champ .err[hidden],.ident .err[hidden]{display:none}
/* panneau : entreprise, polices, styles de texte, colonnes, pied */
.pan-ent{display:flex;gap:12px;align-items:center;margin:0 0 10px}
.pan-ent b{display:block;font-size:14.5px;overflow-wrap:anywhere}.pan-ent span:not(.pan-ent-logo){display:block;font-size:12.5px;color:var(--faible)}
.pan-ent-logo{flex:none;width:44px;height:44px;display:grid;place-items:center;border-radius:10px;background:#fff;box-shadow:inset 0 0 0 1px var(--trait2);color:#18202f;overflow:hidden}
.pan-ent-logo img{max-width:38px;max-height:38px;object-fit:contain}
.pan-corps select,.fen-corps select{width:100%;min-height:40px;padding:0 10px;border:1px solid var(--trait2);border-radius:9px;background:var(--surf2);font-size:16px;font-weight:450;color:var(--encre)}
@media (pointer:coarse),(max-width:760px){.pan-corps select,.fen-corps select,.ident .champ select{min-height:44px}}
.pol-ap{margin:-4px 0 12px;font-size:15px;color:var(--doux);overflow-wrap:anywhere}
.sty-liste{display:flex;flex-direction:column;gap:6px}
.sty{display:flex;align-items:center;gap:12px;min-height:44px;padding:0 10px;border:1.5px solid var(--trait);border-radius:10px;background:var(--surf2);text-align:left;font-size:14.5px}
.sty[aria-expanded="true"]{border-color:var(--accent)}
.sty-ap{flex:none;width:38px;height:30px;display:grid;place-items:center;border-radius:6px;background:#fff;font-size:18px;line-height:1}
.sty-nom{flex:1;min-width:0;font-weight:600}
.sty-ed{padding:10px 10px 4px;margin:-2px 0 4px;border:1.5px solid var(--accent);border-top:0;border-radius:0 0 10px 10px}
.sty-ed .sous{margin:10px 0 6px}
.sty-ed .seg{width:100%}
.col-reg{margin:0 0 6px}
.col-reg label{display:flex;justify-content:space-between;gap:8px;font-size:13px;color:var(--doux);font-weight:600}
.col-reg .val{float:none}
.puces-pied{display:flex;flex-wrap:wrap;gap:6px}
.puce-pied{min-height:34px;padding:0 10px;font-size:13px;white-space:normal;text-align:left}
@media (pointer:coarse),(max-width:760px){.puce-pied{min-height:44px}.sty{min-height:48px}.id-logo-act .bt{min-height:44px}}
@media (max-width:760px){.vig-mini{display:block}}
.vig-mini{display:block;line-height:0;border-radius:3px;overflow:hidden;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.18)}
.vig-mini .gal-p{--s:.133}
@media (max-width:760px){.vig-mini .gal-p{--s:.118}}
.vig svg{display:none}

/* ── 11. PASSE 5 : mise en forme par sélection, objets libres ── */
.ed .l[data-li]{position:relative;padding-left:1.5em}
.ed .l[data-li]::before{position:absolute;left:0;top:0;width:1.1em;text-align:right;pointer-events:none;user-select:none;-webkit-user-select:none}
.ed .l[data-li="p"]::before{content:"•"}
.ed .l[data-li="n"]{counter-set:li var(--n)}
.ed .l[data-li="n"]::before{content:counter(li) "."}
.ed .l[data-lv="1"]{margin-left:1.5em}.ed .l[data-lv="2"]{margin-left:3em}.ed .l[data-lv="3"]{margin-left:4.5em}
/* un objet : posé sur la feuille, jamais dans le flux ; derrière le texte il passe SOUS la zone (le texte reste cliquable), devant il passe sur le pied */
.objs{position:absolute;inset:0;pointer-events:none}
.objs-d{z-index:0}.objs-f{z-index:3}
.obj{position:absolute;box-sizing:border-box;pointer-events:auto;transform-origin:50% 50%;scroll-margin-top:90px}
.edit .obj{cursor:move}
.obj-c{display:block;width:100%;height:100%;box-sizing:border-box}
.obj-texte .obj-c{display:flex;flex-direction:column;overflow:hidden}
.obj-ed{width:100%;min-height:0;pointer-events:none;cursor:inherit}
.obj.edit .obj-ed{pointer-events:auto;cursor:text}
.obj-img{object-fit:cover;-webkit-user-drag:none;user-select:none}
.obj-vide{display:grid;place-items:center;background:var(--p-trait);color:var(--p-faible)}
.obj-vide .ic{width:34px;height:34px}
.edit .obj:hover:not(.sel){outline:1px solid color-mix(in srgb,var(--p-accent) 45%,transparent);outline-offset:1px}
.obj.sel{touch-action:none}
.obj.verrou{cursor:default}
body.obj-glisse,body.obj-glisse *{cursor:move!important;user-select:none;-webkit-user-select:none}
/* cadre, poignées, barre, guides : posés sur le bureau (jamais dans la feuille), à taille constante quel que soit le zoom */
#obj-ov{position:absolute;z-index:14;pointer-events:none;box-sizing:border-box;transform-origin:50% 50%;outline:1.5px solid var(--accent);outline-offset:0}
#obj-ov[hidden],#obj-bar[hidden],#fbar[hidden]{display:none}
#obj-ov .oring{position:absolute;inset:0;pointer-events:none}
#obj-ov .oring::before,#obj-ov .oring::after{content:"";position:absolute;left:-10px;right:-10px;height:10px;pointer-events:auto;cursor:move;touch-action:none}
#obj-ov .oring::before{top:-10px}#obj-ov .oring::after{bottom:-10px}
#obj-ov .oring{--e:10px}
#obj-ov::before,#obj-ov::after{content:"";position:absolute;top:0;bottom:0;width:10px;pointer-events:auto;cursor:move;touch-action:none}
#obj-ov::before{left:-10px}#obj-ov::after{right:-10px}
#obj-ov[data-verrou="1"]{outline-style:dashed}
#obj-ov[data-verrou="1"] .oh,#obj-ov[data-verrou="1"] .oh-rot-l,#obj-ov[data-verrou="1"]::before,#obj-ov[data-verrou="1"]::after,#obj-ov[data-verrou="1"] .oring::before,#obj-ov[data-verrou="1"] .oring::after{display:none}
.oh{position:absolute;width:12px;height:12px;margin:-6px 0 0 -6px;box-sizing:border-box;background:#fff;border:1.5px solid var(--accent);border-radius:3px;pointer-events:auto;touch-action:none;z-index:2}
.oh::after{content:"";position:absolute;inset:-9px}
@media (pointer:coarse){.oh::after{inset:-17px}#obj-ov .oring::before,#obj-ov .oring::after{left:-18px;right:-18px;height:18px}#obj-ov .oring::before{top:-18px}#obj-ov .oring::after{bottom:-18px}#obj-ov::before,#obj-ov::after{width:18px}#obj-ov::before{left:-18px}#obj-ov::after{right:-18px}}
.oh-nw{left:0;top:0;cursor:nwse-resize}.oh-n{left:50%;top:0;cursor:ns-resize}.oh-ne{left:100%;top:0;cursor:nesw-resize}
.oh-e{left:100%;top:50%;cursor:ew-resize}.oh-se{left:100%;top:100%;cursor:nwse-resize}.oh-s{left:50%;top:100%;cursor:ns-resize}
.oh-sw{left:0;top:100%;cursor:nesw-resize}.oh-w{left:0;top:50%;cursor:ew-resize}
.oh-rot{left:50%;top:-32px;border-radius:50%;cursor:grab}
.oh-rot-l{position:absolute;left:50%;top:-26px;height:26px;width:1.5px;margin-left:-.75px;background:var(--accent);pointer-events:none}
#obj-ov[data-ligne="1"] .oh:not(.oh-e):not(.oh-w):not(.oh-rot){display:none}
#obj-bar{position:absolute;z-index:16;display:flex;align-items:center;gap:2px;padding:3px;border-radius:11px;background:var(--surf);border:1px solid var(--trait2);box-shadow:var(--ombre-haute)}
#obj-bar .bt.icone{width:34px;min-height:34px}
#obj-bar .bt[data-danger]{color:var(--rouge)}
@media (pointer:coarse),(max-width:760px){#obj-bar .bt.icone{width:44px;min-height:44px}}
#obj-guides{position:absolute;left:0;top:0;width:0;height:0;z-index:13;pointer-events:none}
.obj-guide{position:absolute;background:#ff2d6f;opacity:.95;pointer-events:none}
.obj-guide.v{width:1px;margin-left:-.5px}.obj-guide.h{height:1px;margin-top:-.5px}
/* la barre flottante de mise en forme : verre discret, au-dessus de la sélection (sur téléphone : dessous, pour ne pas se battre avec la bulle d'iOS) */
#fbar{position:fixed;z-index:90;display:flex;flex-direction:column;padding:4px;border-radius:13px;background:color-mix(in srgb,var(--surf) 90%,transparent);-webkit-backdrop-filter:blur(16px) saturate(1.5);backdrop-filter:blur(16px) saturate(1.5);border:1px solid var(--trait2);box-shadow:var(--ombre-haute);max-width:calc(100vw - 16px);animation:apparait .14s var(--ressort)}
#fbar.dessus{flex-direction:column-reverse}
.fb-rang{display:flex;flex-wrap:wrap;align-items:center;justify-content:center}
.fm-g{display:flex;gap:1px;padding:0 3px;position:relative}
.fm-g+.fm-g::before{content:"";position:absolute;left:-1px;top:7px;bottom:7px;width:1px;background:var(--trait2)}
.fm-b{position:relative;width:34px;height:34px;display:grid;place-items:center;border:0;border-radius:8px;background:transparent;color:var(--encre);padding:0;flex:none}
.fm-b:hover{background:var(--survol)}
.fm-l{font:600 17px/1 "Inter",system-ui,sans-serif;letter-spacing:0}
.fm-lg{font-weight:800}.fm-li{font-style:italic;font-family:Georgia,"Times New Roman",serif;font-size:18px}.fm-lu{text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1.5px}.fm-ls{text-decoration:line-through;text-decoration-thickness:1.5px}
.fm-b[aria-pressed="true"],.fm-b[aria-expanded="true"]{background:var(--accent-fond);color:var(--accent)}
.fm-b:disabled{opacity:.4}
.fm-b .ic{width:18px;height:18px}
.fm-pt{position:absolute;left:9px;right:9px;bottom:4px;height:3px;border-radius:2px;background:var(--cur,transparent)}
@media (pointer:coarse),(max-width:760px){.fm-b{width:44px;height:44px}.fm-b .ic{width:20px;height:20px}.fm-g{padding:0 2px}.fm-g+.fm-g::before{display:none}}
.fb-pop{padding:6px 4px 4px;margin-top:3px;border-top:1px solid var(--trait)}
#fbar.dessus .fb-pop{margin:0 0 3px;border-top:0;border-bottom:1px solid var(--trait)}
.fb-pop[hidden]{display:none}
.fm-couls{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:2px}
.fm-couls .pas{width:28px;height:28px}
@media (pointer:coarse),(max-width:760px){.fm-couls .pas{width:44px;height:44px}.fm-couls{gap:6px}}
.fm-couls .fm-b{border:1px solid var(--trait2);background:var(--surf2)}
.fm-err{margin:4px 2px 0;max-width:300px}
.pas.libre.choisi{box-shadow:0 0 0 2px var(--surf),0 0 0 4px var(--accent)}
.fm-sel .tbar .fm-b{border:1px solid var(--trait2);background:var(--surf2);width:36px;height:36px}
.fm-sel .tbar .fm-b[aria-pressed="true"]{border-color:var(--accent)}
@media (pointer:coarse),(max-width:760px){.fm-sel .tbar .fm-b{width:44px;height:44px}}
.fm-sel .fm-ligne{gap:6px}.fm-sel .fm-g{padding:0;gap:4px}.fm-sel .fm-g::before{display:none}
.pg h4 .val{text-transform:none;letter-spacing:0}
body.fmt-actif #actions{visibility:hidden}
.pg .sous,.fm-sel .sous{margin:12px 0 6px;font-size:12.5px;font-weight:600;color:var(--faible)}
/* l'éditeur riche des feuilles du bas (téléphone) : même contenu que la page, présenté comme un champ */
.ed-mf{min-height:7.5em;padding:10px 12px;border:1px solid var(--trait2);border-radius:10px;background:var(--surf);color:var(--encre);font-size:16px;line-height:1.45;outline:none;cursor:text;overflow-wrap:anywhere;font-weight:400;text-align:left}
.ed-mf:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-fond)}
.ed-mf .l{min-height:1.45em}
.ed-mf .mk[data-m*="h:"]:not([data-m*="c:"]){color:#18202f}
/* l'onglet Objet */
.ob-grille{display:grid;grid-template-columns:1fr 1fr;gap:6px 10px}
.ob-num{margin-bottom:6px}
.ob-liste{display:flex;flex-direction:column;gap:6px}
.ob-liste .bt{justify-content:flex-start}
.ob-liste .bt[aria-pressed="true"]{border-color:var(--accent)}
.pg .err,.pan-bloc-t+.pg .err{font-size:12.5px;color:var(--rouge);margin:6px 0 0}
@media (prefers-reduced-motion:reduce){#fbar{animation:none}}
body.fmt-actif #obj-bar{visibility:hidden}
input[data-ob-r]{display:block;width:100%;margin:6px 0 0}
@media (max-width:760px){.menu{max-height:min(760px,calc(100% - 110px))}}
/* ── 9f. COLONNES, PAGE DE GARDE, SECTIONS TOUTES PRÊTES ── */
.cols{position:relative}
.cols-in{display:flex;gap:var(--cg,24px);overflow:hidden}
.col{min-width:0;display:flex;flex-direction:column;position:relative}
.col>.ed{flex:none}
.cols[data-al="centre"] .col{justify-content:center}.cols[data-al="bas"] .col{justify-content:flex-end}
.cols.filet .col+.col::before{content:"";position:absolute;left:calc(var(--cg,24px) / -2);top:0;bottom:0;width:1px;background:var(--p-trait)}
.cph{margin:0;width:100%}
.cph img{display:block;width:100%;height:auto;border-radius:8px;max-height:calc(1123px - var(--mt) - var(--mb) - 140px);object-fit:cover}
.cph-vide{height:150px;border:1px dashed #b9c0cf;border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;color:var(--p-faible);background:#f8f9fb}
.cph-vide .ic{width:24px;height:24px}
.papier:not(.edit) .cph-vide{border-color:transparent;background:transparent;color:transparent}
.cph figcaption{margin-top:5px}
.cph figcaption .ed{font-size:.84em;color:var(--p-doux);text-align:center}
.col-sep{position:absolute;top:0;bottom:0;width:14px;transform:translateX(-50%);z-index:3;cursor:col-resize;touch-action:none;outline:none}
.col-sep::after{content:"";position:absolute;left:50%;top:10%;bottom:10%;width:3px;margin-left:-1.5px;border-radius:2px;background:var(--p-accent);opacity:0;transition:opacity .12s}
.bloc.sel .col-sep::after,.col-sep:hover::after,.col-sep:focus-visible::after,.col-sep.actif::after{opacity:.85}
.papier:not(.edit) .col-sep{display:none}
@media (max-width:760px),(pointer:coarse){ .col-sep{width:calc(45px / var(--s,1));top:50%;bottom:auto;height:max(100%,calc(45px / var(--s,1)));transform:translate(-50%,-50%)} .col-sep::after{top:50%;bottom:auto;height:calc(30px / var(--s,1));margin-top:calc(-15px / var(--s,1));width:calc(4px / var(--s,1));margin-left:calc(-2px / var(--s,1));border-radius:calc(2px / var(--s,1))} .edit .col-sep::after{opacity:.5} .edit .bloc.sel .col-sep::after{opacity:.9} }      /* au doigt : une POIGNÉE (une pastille de 30 px), pas un trait de la hauteur de la zone tactile */
.pg .seg+.col-reg,.pg .seg+.note{margin-top:12px}
.col-trop{position:absolute;left:0;right:0;bottom:0;z-index:4;display:flex;gap:8px;align-items:center;padding:7px 10px;background:#fff4d6;color:#6b4300;font-size:12px;line-height:1.3;border-top:1px solid #e6c36a;font-family:var(--pf)}
.col-trop .ic{width:16px;height:16px;flex:none}
.t-colonnes{position:relative}
body.col-glisse,body.col-glisse *{cursor:col-resize!important;user-select:none}

/* la page de garde : une page entière, toujours la première, jamais paginée */
.feuille.garde{--zx:0px}
.papier .feuille.garde::before{display:none}
.gd-fond{position:absolute;left:0;right:0;top:0;pointer-events:none}
.gd-logo{position:absolute;z-index:2;left:var(--mx);top:62px;line-height:0;--lg-fond:var(--c);--lg-texte:#fff}
.gd-logo svg{width:68px;height:68px;display:block}
.gd-logo img{display:block;max-height:68px;max-width:240px;width:auto;height:auto}
.gd-corps{position:absolute;z-index:1;left:var(--mx);right:var(--mx);top:0;bottom:0;display:flex;flex-direction:column;padding:190px 0 92px}
.gd-corps{pointer-events:none}.gd-corps .ed{pointer-events:auto}
.gd-haut{flex:1;min-height:0;overflow:hidden;display:flex;flex-direction:column;justify-content:center;padding-bottom:30px}
.gd-type{font-size:13px;letter-spacing:.26em;text-transform:uppercase;font-weight:650;color:var(--c);margin-bottom:18px}
.gd-trait{width:64px;height:4px;border-radius:2px;background:var(--c2);margin:0 0 22px}
.gd-titre,.gd-titre .ed{font-family:var(--pt);font-size:var(--gt,46px);line-height:1.1;font-weight:var(--st-titre-w,650);letter-spacing:-.01em;color:var(--gd-encre,var(--p-encre))}
.gd-t2{--gt:42px}.gd-t3{--gt:34px}.gd-t4{--gt:28px}
.gd-sous,.gd-sous .ed{font-size:20px;line-height:1.35;color:var(--gd-doux,var(--p-doux));margin-top:12px}
.gd-infos{margin-top:auto;display:flex;gap:10px 40px;flex-wrap:wrap;padding-top:22px;border-top:1px solid var(--gd-trait,var(--p-trait))}
.gd-i{min-width:0}
.gd-i small{display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--gd-doux,var(--p-doux));margin-bottom:3px}
.gd-i b{display:block;font-size:15px;font-weight:620;color:var(--gd-encre,var(--p-encre))}
.gd-i span{display:block;font-size:13px;color:var(--gd-doux,var(--p-doux))}
.gd-i-vide b{font-weight:400;font-style:italic;opacity:.6}
.papier:not(.edit) .gd-i-vide{display:none}
.gd-bandeau .gd-fond{height:440px;background:var(--c)}
.gd-bandeau .gd-fond::after{content:"";position:absolute;left:0;right:0;bottom:0;height:6px;background:var(--c2)}
.gd-bandeau .gd-corps{padding-top:150px}
.gd-bandeau .gd-haut{flex:none;height:262px;padding-bottom:0}
.gd-photo .gd-fond{height:560px;background:var(--c-tint)}
.gd-photo .gd-fond img{display:block;width:100%;height:100%;object-fit:cover}
.gd-photo .gd-corps{padding-top:600px}
.gd-photo .gd-haut{justify-content:flex-start}
.gd-ph-vide{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--c);pointer-events:auto;font-size:14px}
.gd-ph-vide .ic{width:34px;height:34px}
.papier:not(.edit) .gd-ph-vide{color:transparent}
.papier:not(.edit) .gd-ph-vide .ic{display:none}
.gd-photo .gd-logo{background:#fff;padding:10px 12px;border-radius:12px;box-shadow:0 2px 10px rgba(11,20,38,.18);top:48px}
.gd-bandeau .gd-logo,.gd-aplat .gd-logo{--lg-fond:#fff;--lg-texte:var(--c)}
.gd-bandeau .gd-logo img,.gd-aplat .gd-logo img{box-sizing:content-box;background:#fff;padding:6px;border-radius:9px}
.gd-aplat{background:var(--c)!important}
.gd-bandeau,.gd-aplat{--gd-encre:#fff;--gd-doux:rgba(255,255,255,.86);--gd-trait:rgba(255,255,255,.4)}
.gd-bandeau .gd-type,.gd-aplat .gd-type{color:rgba(255,255,255,.9)}
.gd-bandeau .gd-trait,.gd-aplat .gd-trait{background:rgba(255,255,255,.9)}
.gd-bandeau .gd-infos{--gd-encre:var(--p-encre);--gd-doux:var(--p-doux);--gd-trait:var(--p-trait)}
.edit .gd-bandeau .gd-haut .ed.vide::before,.edit .gd-aplat .ed.vide::before{color:rgba(255,255,255,.7)}
.edit .gd-bandeau .gd-infos .ed.vide::before{color:var(--p-faible)}
.gd-ed{display:block}

/* la galerie des sections et ses miniatures rognées */
.sec-g{grid-template-columns:repeat(auto-fill,minmax(226px,1fr));align-items:start}
.sec-p{--s:.285;overflow:hidden;height:calc(var(--hh,300px) * var(--s))}
.sec-p .cadre{margin:0}
.gal-w{position:relative;min-width:0}
.gal-w .gal-t{width:100%}
.gal-w .gal-x{position:absolute;right:6px;top:6px;width:44px;height:44px;z-index:2}
.gal-t[disabled]{opacity:.5;cursor:not-allowed}
.gal-p .cph-vide{border-color:#b9c0cf!important;background:#f3f5f9!important}
.gal-p .ph-vide{border-color:#b9c0cf!important;background:#f3f5f9!important}
.gd-g{grid-template-columns:repeat(4,minmax(0,1fr));align-items:start}
.gd-g .gal-p{--s:.2}
.sec-liste{display:flex;flex-direction:column;gap:2px;margin:6px 0 10px}
.sec-liste label{display:flex;gap:10px;align-items:center;min-height:44px;padding:4px 8px;border-radius:10px}
.sec-liste label:hover{background:var(--survol)}
.sec-liste input{width:20px;height:20px;flex:none}
.sec-liste small{color:var(--faible);margin-left:auto;white-space:nowrap}
.sec-liste .sec-t{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media (max-width:760px){ .gd-g{grid-template-columns:repeat(2,minmax(0,1fr))} .sec-p{--s:.2} .sec-g{grid-template-columns:repeat(2,minmax(0,1fr))} .gal-w .gal-x{right:2px;top:2px} }

/* ── 12. PASSE 7 : le PDF réel (bandeau « Préparation… », boutons), l'identité figée, finitions ── */
@keyframes tourne{to{transform:rotate(360deg)}}
.pdf-etat{position:fixed;z-index:85;left:0;right:0;margin:0 auto;bottom:calc(22px + env(safe-area-inset-bottom,0px));width:min(440px,calc(100% - 32px));background:var(--surf);color:var(--encre);border:1px solid var(--trait2);border-radius:14px;box-shadow:var(--ombre-haute);overflow:hidden;animation:monte .2s var(--ressort)}
body.fen-ouverte .pdf-etat,body.ap-ouvert .pdf-etat{top:calc(12px + env(safe-area-inset-top,0px));bottom:auto}
.pdf-in{display:flex;align-items:center;gap:12px;padding:8px 8px 8px 14px}
.pdf-txt{flex:1;min-width:0;display:flex;flex-direction:column;line-height:1.25}
.pdf-txt b{font-size:14.5px}.pdf-txt span{font-size:12.5px;color:var(--faible)}
.pdf-roue{flex:none;width:18px;height:18px;border-radius:50%;border:2.5px solid var(--trait2);border-top-color:var(--accent);animation:tourne .8s linear infinite}
.pdf-barre{height:3px;background:var(--trait)}.pdf-barre i{display:block;height:100%;width:0;background:var(--accent);transition:width .25s}
.pdf-in .bt{min-height:44px}
/* html2canvas dessine le texte sans les chiffres de largeur fixe (tabular-nums) que le navigateur applique : des espaces apparaissaient autour des chiffres et des traits d'union. Le conteneur du PDF utilise donc les chiffres ordinaires — le texte posé et le texte dessiné viennent alors de la même mise en page. */
#pdf-hote,#pdf-hote *{font-variant-numeric:normal!important}
[data-act="pdf-telecharger"].occupe{opacity:.55;cursor:progress}
.ap-pdf{flex:none}
@media (max-width:520px){.ap-pdf .lib-l{display:none}.ap-pdf{width:44px;min-height:44px;padding:0}}
.ap-tit span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cl-lien .ic{width:16px;height:16px;vertical-align:-3px;margin-right:6px}
.env-pj .bt{min-height:44px;flex:none}
.pg.grp>h4{margin:0}.pg.grp .grp-c{padding-top:8px}.pg.grp.ferme{margin-bottom:6px}
.grp-t{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;min-height:34px;margin:0;padding:4px 2px;border:0;border-radius:8px;background:none;color:inherit;font:inherit;letter-spacing:inherit;text-transform:inherit;text-align:left;cursor:pointer}
.grp-t:hover{background:var(--survol)}.grp-t:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
.grp-t .ic{flex:none;width:16px;height:16px;transition:transform .15s}.grp-t[aria-expanded="false"] .ic{transform:rotate(-90deg)}
.grp-n{flex:1;min-width:0}.grp-n .val{margin-right:4px}
.grp-tout{display:flex;justify-content:flex-end;gap:4px;margin:-6px 0 6px}.grp-tout .bt{min-height:34px;font-size:13px;color:var(--faible)}
@media (pointer:coarse),(max-width:760px){.grp-t{min-height:44px}.grp-tout .bt{min-height:44px;padding:0 10px}}
@media (prefers-reduced-motion:reduce){.grp-t .ic{transition:none}}
.gal-w{position:relative;min-width:0;display:flex}.gal-w .gal-t{flex:1;min-width:0}
.bt.icone.gal-sup{position:absolute;top:2px;right:2px;width:44px;height:44px;min-height:44px;border-radius:50%;background:var(--surf);box-shadow:var(--ombre-seg);z-index:1}
.modele-l .bt.icone{width:44px;min-height:44px;flex:none}
.note.fige{display:flex;gap:8px;align-items:flex-start}.note.fige .ic{flex:none;width:15px;height:15px;margin-top:2px}.note.fige span{min-width:0}

/* ── v7 : mes en-têtes, devis vierge ── */
.entree-w{display:flex;flex-direction:column;gap:8px;min-width:0}
.entree-w .entree{flex:1}
.entree-lien{width:100%;min-height:44px;justify-content:flex-start;padding:0 14px;font-size:14px;border-radius:12px}
.ent-lg{flex:none;display:grid;place-items:center;width:44px;height:44px;border-radius:10px;background:#fff;box-shadow:inset 0 0 0 1px var(--trait2);color:#18202f;overflow:hidden;line-height:0}
.ent-lg img{max-width:38px;max-height:38px;object-fit:contain}.ent-lg svg{width:38px;height:38px}
.ent-tx{min-width:0;display:flex;flex-direction:column;text-align:left}
.ent-tx b{font-size:14.5px;overflow-wrap:anywhere}.ent-tx span{font-size:12.5px;color:var(--faible);overflow-wrap:anywhere}
.ent-pas{display:inline-block;flex:none;width:14px;height:14px;border-radius:50%;background:var(--pc);box-shadow:0 0 0 1px var(--trait2)}
.ent-def{margin-left:8px;padding:1px 8px;border-radius:999px;font-style:normal;font-size:11.5px;font-weight:650;background:var(--accent-fond);color:var(--accent);white-space:nowrap}
.ent-l{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:12px;border:1px solid var(--trait);border-radius:14px;background:var(--surf2)}
.ent-l+.ent-l{margin-top:10px}.ent-l .ent-tx{flex:1;min-width:140px}
.ent-ac{display:flex;gap:6px;flex-wrap:wrap;width:100%}.ent-ac .bt{min-height:36px;padding:0 10px}
.ent-cartes{display:flex;flex-direction:column;gap:8px;margin:0 0 10px}
.ent-c{display:flex;align-items:center;gap:12px;width:100%;min-height:56px;padding:6px 12px;border:1.5px solid var(--trait);border-radius:12px;background:var(--surf2);text-align:left;color:var(--encre)}
.ent-c:hover{border-color:var(--trait2)}
.ent-c[aria-pressed="true"]{border-color:var(--accent);background:var(--accent-fond)}
.ent-c[aria-pressed="true"] .ent-tx span,.vv-cl[aria-pressed="true"] span{color:var(--doux)}       /* sur le fond de la carte choisie, la teinte « faible » tombait à 4,40:1 de nuit (mesuré par a7) */
.ent-c:disabled{opacity:.55;cursor:default}
.fenetre.vierge{width:min(1060px,100%);max-height:min(92%,900px)}
.vv{display:grid;grid-template-columns:minmax(0,1fr) 300px;grid-template-areas:"form ap";gap:22px;align-items:start}
.vv-form{grid-area:form;min-width:0}
.vv-ap{grid-area:ap;position:sticky;top:0;align-self:start}
.vv-ap-cadre{display:block;line-height:0;border-radius:4px;overflow:hidden;background:#fff;box-shadow:var(--ombre-feuille)}
.vv-ap .gal-p{--s:.37}
.vv-ap-note{margin:8px 0 0;font-size:12.5px;color:var(--faible);text-wrap:pretty}
.vv-s{margin:0 0 10px}
.vv .sous{margin:12px 0 6px;font-size:13px;font-weight:600;color:var(--doux)}
.vv-cartes{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:8px;margin:0 0 10px}
.vv-act{display:flex;gap:8px;flex-wrap:wrap}
.vv-logo{display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap;margin:0 0 10px}
.vv-logo-ap{flex:none;width:150px;height:84px;display:grid;place-items:center;border:1px dashed var(--trait2);border-radius:12px;background:#fff;overflow:hidden;line-height:0}
.vv-logo-ap img{max-width:132px;max-height:68px;object-fit:contain}.vv-logo-ap svg{width:64px;height:64px}
.vv-logo-r{flex:1;min-width:200px}
.vv-logo-r .seg{max-width:340px}
.vv-n{margin:8px 0 0;font-size:13px}
.vv-clients{display:flex;flex-direction:column;gap:2px;max-height:236px;overflow:auto;margin:0 0 8px;padding:2px;border:1px solid var(--trait);border-radius:12px;background:var(--surf2)}
.vv-cl{display:flex;flex-direction:column;align-items:flex-start;gap:0;min-height:48px;padding:6px 12px;border:1.5px solid transparent;border-radius:9px;background:none;text-align:left;color:var(--encre)}
.vv-cl:hover{background:var(--survol)}
.vv-cl:hover span{color:var(--doux)}
.vv-cl[aria-pressed="true"]{border-color:var(--accent);background:var(--accent-fond)}
.vv-cl b{font-size:14.5px;overflow-wrap:anywhere}.vv-cl span{font-size:12.5px;color:var(--faible);overflow-wrap:anywhere}
.vv-vide{margin:6px 10px}
.vv-vig{display:grid;grid-template-columns:repeat(auto-fill,minmax(118px,1fr));gap:10px}
.vierge .seg button{min-height:36px}
@media (pointer:coarse),(max-width:760px){.vierge .seg button{min-height:44px}.ent-ac .bt{min-height:44px}.vv-act .bt,.vierge .vv-s>.bt{min-height:44px}}
@media (max-width:760px){
  .vv{display:block}
  .vv-ap{position:sticky;z-index:3}
  .vv-cartes{grid-template-columns:1fr}
  .vv-vig{grid-template-columns:repeat(2,minmax(0,1fr))}
  .vv-logo-ap{width:100%}
}
/* ── v10 : le compositeur (étapes, catalogue, lignes, aperçu) ── */
.fenetre.vierge{width:min(1100px,100%);max-height:min(92%,920px)}
.vv{grid-template-columns:minmax(0,1fr) 340px}
.vv-ap .gal-p{--s:.42}
.vv-intro{margin-top:6px}
.vierge .vv-act .bt,.vierge .vv-c>.bt{white-space:normal;max-width:100%;height:auto;text-align:center;line-height:1.25;padding-top:7px;padding-bottom:7px}
.vierge ::placeholder{color:var(--faible);opacity:1}
.vv-clients{max-height:none;overflow:visible}
.vv-ap-bar{display:none}
.vv-e{margin:0 0 10px;border:1px solid var(--trait);border-radius:14px;background:var(--surf)}
.vv-eh{margin:0}
.vv-eb{display:flex;align-items:center;gap:12px;width:100%;min-height:56px;padding:8px 14px;border:0;border-radius:14px;background:none;text-align:left;color:var(--encre)}
.vv-eb:hover{background:var(--survol)}
.vv-eb>.ic{flex:none;width:18px;height:18px;color:var(--faible);transition:transform .18s var(--ressort)}
.vv-eb[aria-expanded="true"]>.ic{transform:rotate(180deg)}
.vv-num{flex:none;display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--accent-fond);color:var(--encre);font-size:13px;font-weight:700}
.vv-et{flex:1;min-width:0;display:flex;flex-direction:column}
.vv-et b{font-size:15.5px;font-weight:650}
.vv-res{font-size:13px;color:var(--faible);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.vv-c{padding:2px 14px 14px}
.vv-c[hidden]{display:none}
.vv-sub{margin:14px 0 6px;font-size:12px;font-weight:650;letter-spacing:.06em;text-transform:uppercase;color:var(--faible)}
.vv-sub2{margin-top:16px}
.vv-sub span{text-transform:none;letter-spacing:0;font-weight:600}
.vv-c>.vv-sub:first-child{margin-top:4px}
.champ textarea.vv-une,.fen-corps .champ textarea.vv-une,.vv-pl .champ textarea.vv-une{min-height:68px;resize:none;line-height:1.35;overflow:auto}
@media(max-width:520px){.champ textarea.vv-une,.fen-corps .champ textarea.vv-une,.vv-pl .champ textarea.vv-une{min-height:96px}}      /* délai et paiement : une phrase qui peut tenir sur deux lignes, jamais coupée net au bord du champ */
.vv-ta{width:100%;min-height:64px;padding:10px 12px;border:1px solid var(--trait2);border-radius:9px;background:var(--surf2);color:var(--encre);font:inherit;font-size:16px;font-weight:450;line-height:1.4;resize:vertical}
.vierge .champ .vv-ta{min-height:64px}
.vv-ta:focus,.vv-rech input:focus,.vv-mini input:focus{outline:2px solid var(--accent);outline-offset:0;border-color:transparent}
.vv-rech input{width:100%;min-height:46px;padding:0 12px;border:1px solid var(--trait2);border-radius:10px;background:var(--surf2);color:var(--encre);font-size:16px}
.vv-cats,.vv-chips{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 8px}
.vv-chips{margin:2px 0 10px}
.vv-pas,.vierge .chip-i{min-height:36px;padding:0 13px;border:1px solid var(--trait2);border-radius:999px;background:var(--surf2);color:var(--doux);font-size:13.5px;font-weight:600;white-space:normal;text-align:left;line-height:1.25}
.vierge .chip-i{max-width:100%;padding:6px 13px;overflow:visible;text-overflow:clip}
.vv-pas i{font-style:normal;font-weight:700;color:var(--faible)}
.vv-pas[aria-pressed="true"],.vierge .chip-i[aria-pressed="true"]{background:var(--accent-fond);border-color:var(--accent);color:var(--accent)}
.vv-pas[aria-pressed="true"] i{color:var(--accent)}
.vv-cat{display:flex;flex-direction:column;gap:2px;max-height:310px;overflow:auto;overscroll-behavior:contain;padding:2px;border:1px solid var(--trait);border-radius:12px;background:var(--surf2)}
.vv-art{display:flex;align-items:stretch;gap:2px;border-radius:9px;border:1.5px solid transparent}
.vv-art.est{border-color:var(--accent);background:var(--accent-fond)}
.vv-art-b{flex:1;min-width:0;display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:54px;padding:6px 12px;border:0;border-radius:9px;background:none;text-align:left;color:var(--encre)}
button.vv-art-b:hover{background:var(--survol)}
.vv-art-t{min-width:0;display:flex;flex-direction:column}
.vv-art-t b{font-size:14.5px;font-weight:600;overflow-wrap:anywhere}
.vv-art-t b small{font-weight:500;color:var(--doux)}
.vv-art-t i{font-style:normal;font-size:12.5px;color:var(--faible);overflow-wrap:anywhere}
.vv-art.est .vv-art-t i{color:var(--doux)}
.vv-art-p{flex:none;text-align:right;font-size:14px;font-weight:650;font-variant-numeric:tabular-nums;max-width:45%;overflow-wrap:anywhere}
.vv-art-p small{display:block;font-size:11.5px;font-weight:500;color:var(--faible)}
.vv-art-x{flex:none;width:44px;border:0;border-radius:9px;background:none;color:var(--rouge)}
.vv-art-x .ic{width:18px;height:18px}
.vv-coche{flex:none;display:grid;place-items:center;width:28px;height:28px;border-radius:50%;color:var(--faible)}
.vv-art.est .vv-coche{background:var(--accent);color:var(--on-accent)}
.vv-coche .ic{width:16px;height:16px}
.vv-pm{flex:none;display:flex;align-items:center;gap:4px}
.vv-pm button{display:grid;place-items:center;width:40px;height:40px;border:1px solid var(--trait2);border-radius:50%;background:var(--surf);color:var(--encre)}
.vv-pm button .ic{width:18px;height:18px}
.vv-pm output{min-width:34px;text-align:center;font-size:15px;font-weight:700;font-variant-numeric:tabular-nums}
.vv-cnt{margin:6px 2px 10px;font-size:12.5px;color:var(--faible)}
.vv-mem{margin:8px 0}
.vv-bib-t{margin:8px 10px 2px;font-size:11.5px;font-weight:650;letter-spacing:.05em;text-transform:uppercase;color:var(--faible)}
.vv-libre-b{margin-top:4px}
.vv-libre{margin:8px 0 4px;padding:12px;border:1px dashed var(--trait2);border-radius:12px}
.vv-libre[hidden]{display:none}
.vv-libre .interr{margin:2px 0 8px}
.vv-lig{list-style:none;margin:0;padding:0}
.vv-l{padding:10px 0;border-top:1px solid var(--trait)}
.vv-l:first-child{border-top:0}
.vv-l-cat{margin:14px 0 2px;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--doux)}
.vv-l-cat:first-child{margin-top:2px}
.vv-l-t{font-size:14.5px;font-weight:600;overflow-wrap:anywhere}
.vv-l-t i{margin-left:8px;font-style:normal;font-weight:500;font-size:12.5px;color:var(--faible)}
.vv-opt-b{margin-left:8px;padding:1px 8px;border-radius:999px;font-style:normal;font-size:11.5px;font-weight:650;background:var(--accent-fond);color:var(--accent);white-space:nowrap}
.vv-l.opt .vv-l-t{color:var(--doux)}
.vv-l-c{display:flex;flex-wrap:wrap;align-items:flex-end;gap:8px 10px;margin-top:6px}
.vv-mini{display:flex;flex-direction:column;gap:2px;font-size:12px;font-weight:600;color:var(--faible)}
.vv-mini input{width:96px;min-height:44px;padding:0 10px;border:1px solid var(--trait2);border-radius:9px;background:var(--surf2);color:var(--encre);font-size:16px;font-weight:500;text-align:right;font-variant-numeric:tabular-nums}
.vv-mini input[aria-invalid="true"]{border-color:var(--rouge)}
.vv-u{align-self:center;padding-bottom:0;font-size:13px;color:var(--doux);margin-top:16px}
.vv-l-m{margin-left:auto;align-self:center;margin-top:16px;max-width:100%;font-weight:700;font-size:15px;font-variant-numeric:tabular-nums;text-align:right;overflow-wrap:anywhere}
.vv-l .err{display:block;margin-top:4px;color:var(--rouge);font-size:13px;font-weight:550}
.vv-l-a{display:flex;flex-wrap:wrap;align-items:center;gap:2px 6px;margin-top:4px}
.vv-l-a .interr{margin-right:auto}
.vv-l-a .bt.icone{width:44px;min-height:44px}
.vv-l-a .bt.danger{color:var(--rouge)}
.vv-a{display:flex;flex-wrap:wrap;align-items:center;gap:2px 8px}
.vv-a .vv-l-a{flex:0 1 auto;max-width:100%;margin:0}      /* elle rétrécit (et passe à la ligne) au lieu de sortir de la colonne à 320 px : « Retirer » ne se coupe plus */
.vv-a-t{flex:1 1 220px;min-width:0;display:flex;align-items:flex-start;gap:10px;font-size:14.5px}
.vv-a-e{flex:1 1 100%}
.vv-a>.fen-note{flex:1 1 100%}
.vv-a-t b{min-width:0;overflow-wrap:anywhere;font-weight:600}
.vv-a-n{flex:none;display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:var(--accent-fond);color:var(--encre);font-size:12.5px;font-weight:700}
.vv-a .vv-l-a .bt.contour{margin-right:4px}
@media (max-width:400px){.vv-a .vv-l-a{gap:2px}.vv-a .vv-l-a .bt.contour{margin-right:0}}      /* 360 px : « Modifier le texte · ↑ · ↓ · ✕ » tiennent sur UNE ligne (sinon ✕ restait seul dessous) ; les icônes gardent leurs 44 px de toucher */
.vv-a-e{margin:8px 0 0}
.vv-vide-l:empty{display:none}
.vv-rg{margin-top:6px}
.vv-tot{margin:10px 0 0;padding:12px 14px;border-radius:12px;background:var(--surf2);border:1px solid var(--trait)}
.vv-t{display:flex;justify-content:space-between;gap:12px;padding:2px 0;font-size:14px;color:var(--doux)}
.vv-t b{color:var(--encre);font-variant-numeric:tabular-nums;text-align:right;overflow-wrap:anywhere}
.vv-t.g{margin-top:4px;padding-top:8px;border-top:1px solid var(--trait2);font-size:16px;color:var(--encre)}
.vv-t.g b{font-size:18px}
.vv-t-o{margin:6px 0 0;font-size:12.5px;color:var(--faible)}
.vv-var{margin:0 0 2px}
.vv-var .champ{margin-bottom:6px}
.vv-var .err{color:var(--rouge);font-weight:550;font-size:13px}
.vv-ac-a[hidden]{display:none}
.vv-pied-tot{flex:1;min-width:0;display:flex;flex-direction:column;align-items:flex-end;justify-content:center;line-height:1.15;text-align:right}
.vv-pied-tot small{font-size:11.5px;font-weight:600;color:var(--faible)}
.vv-pied-tot b{font-size:17px;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.vierge .fen-pied{align-items:center}
.vv-grand{position:absolute;inset:0;z-index:6;display:flex;flex-direction:column;background:var(--surf);border-radius:inherit}
.vv-grand-t{flex:none;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid var(--trait)}
.vv-grand-c{flex:1;min-height:0;overflow:auto;padding:14px 12px calc(14px + env(safe-area-inset-bottom,0px));background:var(--bureau)}
.vv-grand .vv-ap-cadre{margin:0 auto;width:max-content;max-width:100%}
.vv-grand .vv-ap-cadre .gal-p{--s:var(--vs,.45)}
@media (pointer:coarse),(max-width:760px){
  .vv-pas,.vierge .chip-i{min-height:44px}
  .vv-pm button{width:44px;height:44px}
  .vierge .interr{min-height:48px}
}
@media (max-width:760px){
  .vv-ap{top:-6px;margin:-6px -18px 10px;padding:8px 18px;background:var(--surf);border-bottom:1px solid var(--trait)}
  .vv-ap-bar{display:flex;align-items:center;justify-content:space-between;gap:10px}
  .vv-ap-t{min-width:0;display:flex;flex-direction:column;line-height:1.15}
  .vv-ap-t span{font-size:11.5px;font-weight:600;color:var(--faible)}
  .vv-ap-t b{font-size:18px;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
  .vv-ap-cadre,.vv-ap-note{display:none}
  .vv-grand .vv-ap-cadre{display:block}
  .vv-pied-tot{display:none}
  .vv-intro{display:none}
  .vv-eb{padding:8px 12px}
  .vv-c{padding:2px 12px 14px}
  .vv-art-p{max-width:40%}
  .vv-mini input{width:104px}
}
/* ── 13. DANS OP GESTION : pas d'accueil (le prototype est l'accueil), pas de marque, pas de sélecteur de thème ── */
html[data-app] #vue-accueil{display:none!important}
/* Mesuré dans le cadre (mêmes profils que le prototype) : sur iPad la barre de l'éditeur a des boutons de 40 px de large et le nom du document est en 15 px (iOS zoome sous 16) ;
   à 320 px le bouton « Optimiser » de la barre du bas était écrasé à 22 px (son libellé débordait sur ses voisins) ; les poignées de ligne et la date du document, posées SUR la feuille,
   n'ont que 21–26 px : on étend leur zone de toucher sans changer la feuille (un pseudo-élément transparent), jamais leur taille. Seulement dans OP GESTION : la page seule ne bouge pas. */
@media (pointer:coarse){
  html[data-app] .barre .bt{min-width:44px}
  html[data-app] .nom-doc{font-size:16px}
  html[data-app] .interr{min-height:44px}      /* les interrupteurs « PDF joint », « Lien pour accepter… », « Ce que voit le client » : la rangée entière est la cible, 38 px sur iPad */
  html[data-app] .rt::after{content:'';position:absolute;inset:-9px -11px}
  html[data-app] button.ct-date{position:relative}
  html[data-app] button.ct-date::after{content:'';position:absolute;inset:-13px -8px}
}
@media (max-width:380px){
  html[data-app] .barre-bas{gap:2px;padding-left:max(6px,env(safe-area-inset-left,0px));padding-right:max(6px,env(safe-area-inset-right,0px))}
  html[data-app] .barre-bas .bt{min-width:0;padding:0 1px;font-size:10.5px}
}
/* ── 14. LE COMPOSITEUR EN GRAND — dans OP GESTION seulement (la classe .plein n'existe qu'avec ?app=1 ; la page seule garde sa fenêtre) ──
   Justin, 16 novembre 2026 : « composer un devis, c'est trop petit ». Mesuré avant : une fenêtre de 1 100 px posée sur un voile gris, et une page d'aperçu de 333 px
   (texte rendu à 5 px). Maintenant le compositeur occupe TOUT l'écran : à gauche les étapes (qui défilent), à droite la PAGE du document sur un fond de bureau (qui défile,
   avec son réglage de taille). Ce qui défile est la colonne des étapes, jamais la fenêtre. Trois formes, décidées sur la largeur de l'écran :
   · ≥ 1 032 px : deux colonnes (étapes 40 %, de 480 à 620 px ; la page garde au moins 480 px) et « Créer » remonte dans la barre du haut, à côté du total ;
   · moins : une seule colonne, une barre « Total · Aperçu » au-dessus des étapes, « Créer » en bas ; « Aperçu » ouvre la page en grand, réglable ;
   · téléphone : pareil, champs et boutons au doigt (44 à 48 px). */
@keyframes vvFondu{from{opacity:0}to{opacity:1}}
.voile.plein{padding:0;align-items:stretch;justify-content:stretch;background:var(--surf)}
.voile.plein .fenetre.vv-pl{width:100%;max-width:none;height:100%;max-height:none;border-radius:0;box-shadow:none;border:0;animation:vvFondu .16s ease both;display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr) auto;overflow:hidden}
@media (prefers-reduced-motion:reduce){.voile.plein .fenetre.vv-pl{animation:none}}
.vv-pl .fen-tete.vv-hd{gap:6px;min-height:64px;padding:8px max(14px,env(safe-area-inset-right,0px)) 8px max(6px,env(safe-area-inset-left,0px));border-bottom:1px solid var(--trait);background:var(--surf)}
.vv-pl .fen-tete.vv-hd::before{display:none}
.vv-pl .vv-hd h3{margin:0;font-size:19px;font-weight:650;text-wrap:balance;overflow-wrap:anywhere}
.vv-pl .vv-retour{flex:none;min-height:48px;padding:0 14px 0 6px;font-size:16px;font-weight:600;color:var(--accent)}
.vv-pl .vv-retour .ic{width:22px;height:22px}
.vv-pl .fen-pied{flex-wrap:nowrap;align-items:center;justify-content:flex-end;gap:12px;padding:10px max(16px,env(safe-area-inset-right,0px)) calc(12px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px));border-top:1px solid var(--trait);background:var(--surf)}
.vv-pl .fen-pied .bt.primaire{flex:1 1 auto;min-height:52px;font-size:17px}
.vv-pl .vv-pied-tot{display:none}
.vv-pl .fen-corps{display:flex;flex-direction:column;min-height:0;padding:0;overflow:hidden}
.vv-pl .vv{flex:1;min-height:0;display:flex;flex-direction:column;align-items:stretch;gap:0}      /* « align-items:start » de la fenêtre d'avant laissait la colonne des étapes à sa largeur naturelle : 441 px dans un écran de 390 */
.vv-pl .vv-form{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;padding:16px max(18px,calc((100% - 720px)/2)) 40px}
.vv-pl .vv-ap{position:static;z-index:auto;flex:none;margin:0;padding:8px max(16px,env(safe-area-inset-right,0px)) 8px max(16px,env(safe-area-inset-left,0px));background:var(--surf);border-bottom:1px solid var(--trait);align-self:auto}
.vv-pl .vv-ap-bar{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:52px}
.vv-pl .vv-ap-bar .bt{min-height:48px;font-size:16px}
.vv-pl .vv-ap-t{display:flex;flex-direction:column;line-height:1.15;min-width:0}
.vv-pl .vv-ap-t span{font-size:12.5px}.vv-pl .vv-ap-t b{font-size:20px}
.vv-pl .vv-ap-tools,.vv-pl .vv-ap-sc{display:none}
.vv-pl .vv-intro{display:block;font-size:15px}
/* la page : elle prend la taille que dit --vs (posé par vvEchelle sur la zone qui défile) ; les pages se suivent avec un intervalle, sur le fond de bureau */
.vv-pl .vv-ap-cadre,.vv-grand-plein .vv-ap-cadre{display:block;width:max-content;max-width:none;margin:0 auto;border-radius:0;overflow:visible;background:none;box-shadow:none;line-height:normal}
.vv-pl .vv-ap-cadre .gal-p,.vv-grand-plein .vv-ap-cadre .gal-p{--s:var(--vs,.6)}
.vv-pl .gal-p .cadre,.vv-grand-plein .gal-p .cadre{margin:0 0 20px}
.vv-pl .gal-p .feuille,.vv-grand-plein .gal-p .feuille{box-shadow:var(--ombre-feuille)}
.vv-zoom{flex:none;max-width:100%}
.vv-zoom button{min-height:40px;padding:0 10px;font-size:14px;white-space:nowrap}
.vv-grand-plein .vv-grand-t{padding:10px 16px;min-height:60px}
.vv-grand-plein .vv-grand-t .bt{min-height:48px}
.vv-grand-plein .vv-grand-z{flex:none;display:flex;flex-direction:column;align-items:center;gap:6px;padding:8px 16px;border-bottom:1px solid var(--trait);background:var(--surf)}
.vv-grand-plein .vv-grand-z .vv-zoom{width:100%;max-width:420px}.vv-grand-plein .vv-grand-z .vv-zoom button{flex:1;min-height:44px}
.vv-grand-n{margin:0;font-size:13px;line-height:1.35;color:var(--doux);text-align:center;text-wrap:balance}
.vv-grand-plein .vv-grand-c{padding:20px 16px calc(24px + env(safe-area-inset-bottom,0px))}
/* champs et boutons à la taille des écrans d'OP GESTION : 48 px de haut, texte de 16 à 17 px, titres d'étape de 18 px */
.vv-pl .champ{font-size:14px}
.vv-pl .champ input,.vv-pl .champ select{min-height:48px;padding:0 12px;font-size:17px}
.vv-pl .vv-ta,.vv-pl .champ textarea{font-size:17px;min-height:88px}
.vv-pl .vv-rech input{min-height:48px;font-size:17px}
.vv-pl .vv-eb{min-height:68px;padding:10px 16px}
.vv-pl .vv-et b{font-size:18px}
.vv-pl .vv-res{font-size:14px}
.vv-pl .vv-num{width:32px;height:32px;font-size:15px}
.vv-pl .vv-sub{font-size:13px}
.vv-pl .vv-cl{min-height:56px}.vv-pl .vv-cl b{font-size:16.5px}.vv-pl .vv-cl span{font-size:14px}
.vv-pl .vv-clients{max-height:none}
.vv-pl .vv-cat{max-height:min(480px,55vh)}
.vv-pl .vv-art-b{min-height:64px}.vv-pl .vv-art-t b{font-size:16.5px}.vv-pl .vv-art-t i{font-size:14px}.vv-pl .vv-art-p{font-size:16px}.vv-pl .vv-art-p small{font-size:12.5px}
.vv-pl .vv-pm button{width:44px;height:44px}.vv-pl .vv-pm output{font-size:17px}
/* un nom d'article ne se coupe pas au milieu d'un mot : « allumag / e » à 320 px. Le nom garde une base de 9,5 em ; s'il n'a plus la place à côté du compteur, le compteur passe dessous, à droite */
.vv-pl .vv-art-b.ajoute{flex-wrap:wrap;row-gap:6px}
.vv-pl .vv-art-t{flex:1 1 9.5em}
.vv-pl .vv-art-t b,.vv-pl .vv-art-t i{overflow-wrap:break-word}
.vv-pl .vv-art-b.ajoute .vv-pm{margin-left:auto}
.vv-pl .vv-pas,.vv-pl .chip-i{min-height:44px;font-size:15px}
.vv-pl .vv-act .bt,.vv-pl .vv-c>.bt,.vv-pl .vv-s>.bt{min-height:48px;font-size:16px}
.vv-pl .seg button{min-height:44px;font-size:15px}
.vv-pl .interr{min-height:48px}
.vv-pl .vv-mini{font-size:13px}.vv-pl .vv-mini input{min-height:48px;font-size:17px}
.vv-pl .vv-l-t{font-size:16.5px}.vv-pl .vv-l-m{font-size:16px}
.vv-pl .vv-t{font-size:15px}.vv-pl .vv-t.g{font-size:17px}.vv-pl .vv-t.g b{font-size:20px}
.vv-pl .vv-a-t{font-size:16px}
.vv-pl .fen-note{font-size:14.5px}
@media (min-width:1032px){
  .voile.plein .fenetre.vv-pl{grid-template-columns:minmax(0,1fr) auto;grid-template-rows:auto minmax(0,1fr)}
  .vv-pl .fen-tete.vv-hd{grid-column:1;grid-row:1}
  .vv-pl .fen-pied{grid-column:2;grid-row:1;min-height:64px;padding:8px 24px 8px 12px;border-top:0;border-bottom:1px solid var(--trait)}
  .vv-pl .fen-pied .bt.primaire{flex:none;min-height:48px;font-size:16px}
  .vv-pl .vv-pied-tot{display:flex}
  .vv-pl .vv-pied-tot small{font-size:12px}.vv-pl .vv-pied-tot b{font-size:20px}
  .vv-pl .fen-corps{grid-column:1/3;grid-row:2}
  .vv-pl .vv{display:grid;grid-template-columns:clamp(480px,40%,620px) minmax(0,1fr);grid-template-areas:"form ap";align-items:stretch}
  .vv-pl .vv-form{grid-area:form;padding:20px 28px 48px;border-right:1px solid var(--trait)}
  .vv-pl .vv-ap{grid-area:ap;display:flex;flex-direction:column;min-width:0;min-height:0;padding:0;background:var(--bureau);border-bottom:0}
  .vv-pl .vv-ap-bar{display:none}
  .vv-pl .vv-ap-tools{flex:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:10px 24px;background:var(--surf);border-bottom:1px solid var(--trait)}
  .vv-pl .vv-ap-note{margin:0;min-width:0;font-size:14px;color:var(--doux);text-wrap:pretty}
  .vv-pl .vv-ap-sc{flex:1;min-height:0;display:block;overflow:auto;overscroll-behavior:contain;padding:28px 32px 40px}
}
</style>

<!-- Icônes : traits fins, même épaisseur partout (stroke 1.6), dessinées ici — aucune image externe -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <symbol id="i-chevron-left" viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></symbol>
  <symbol id="i-chevron-down" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></symbol>
  <symbol id="i-chevron-right" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></symbol>
  <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
  <symbol id="i-undo" viewBox="0 0 24 24"><path d="M9 14L4 9l5-5"/><path d="M4 9h10a6 6 0 010 12h-3"/></symbol>
  <symbol id="i-redo" viewBox="0 0 24 24"><path d="M15 14l5-5-5-5"/><path d="M20 9H10a6 6 0 000 12h3"/></symbol>
  <symbol id="i-layout" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2.5"/><path d="M4 10h16M10 10v10"/></symbol>
  <symbol id="i-sliders" viewBox="0 0 24 24"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></symbol>
  <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></symbol>
