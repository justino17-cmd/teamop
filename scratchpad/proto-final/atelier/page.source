  <symbol id="i-indent-plus" viewBox="0 0 24 24"><path d="M4 6h16M12 11h8M12 16h8M4 20h16M4 10l4 3-4 3z"/></symbol>
  <symbol id="i-indent-moins" viewBox="0 0 24 24"><path d="M4 6h16M12 11h8M12 16h8M4 20h16M8 10l-4 3 4 3z"/></symbol>
