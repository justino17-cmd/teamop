  <symbol id="i-sections" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="7" rx="1.6"/><rect x="4" y="14" width="16" height="6" rx="1.6"/></symbol>
  <symbol id="i-garde" viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8.5 15h7M8.5 11h7M8.5 7h4"/></symbol>
